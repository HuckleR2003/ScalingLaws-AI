/*
 * Scaling Laws theme.
 *
 * Deliberately a first pass in the visual language of the tycoon games this is modelled on:
 * a deep blue field, a translucent left rail, and a grid of dark photo cards with an uppercase
 * title, a level and a price. Every colour and size in this file is a token. Restyling the whole
 * game later should mean editing this file and dropping in card art, not touching C#.
 *
 * Card art: every .card gets its background from a --card-image variable set in code, so the
 * placeholder blocks below can be swapped for textures without a layout change.
 */

:root {
    --blue-900: rgb(6, 32, 66);
    --blue-800: rgb(9, 45, 90);
    --blue-700: rgb(13, 62, 118);
    --blue-600: rgb(18, 84, 158);
    --blue-400: rgb(56, 138, 220);

    --rail: rgba(6, 30, 62, 0.72);
    --rail-active: rgba(120, 170, 225, 0.22);

    --ink: rgb(255, 255, 255);
    --ink-dim: rgba(226, 238, 252, 0.72);
    --ink-faint: rgba(226, 238, 252, 0.45);

    --good: rgb(78, 205, 148);
    --warn: rgb(240, 186, 78);
    --bad: rgb(233, 96, 96);
    --locked: rgba(10, 24, 44, 0.78);

    --card-radius: 4px;
    --gutter: 16px;
}

.root {
    flex-grow: 1;
    background-color: var(--blue-800);
    color: var(--ink);
    font-size: 14px;
}

/* ---- main menu -------------------------------------------------------- */

/*
 * Structure borrowed from BakaBakeBakery, tone deliberately not.
 *
 * That menu is warm, rounded and inviting because it is about a bakery. This one is about a server
 * room in 2022, so the same skeleton gets hard edges, monospaced numerals, a printed circuit green
 * for anything live, and a decorative panel that is a training run rather than a shop window.
 *
 * The panel on the right is built entirely from styled elements. No image is loaded for it, which
 * is why the menu looked finished before any art existed and will keep working if art never arrives.
 */

.menu-root {
    flex-grow: 1;
    background-color: var(--blue-900);
    justify-content: center;
    padding-left: 90px;
    padding-right: 90px;
}

.menu-layout {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.menu-copy {
    width: 560px;
}

.menu-eyebrow {
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--ink-faint);
    margin-bottom: 18px;
}

.title-lockup {
    margin-bottom: 18px;
}

.title-line {
    font-size: 74px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--ink);
}

.title-line--small {
    font-size: 30px;
    letter-spacing: 12px;
    color: var(--ink-dim);
}

.title-line--accent {
    color: var(--good);
}

.menu-subtitle {
    color: var(--ink-dim);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 34px;
    max-width: 460px;
}

.menu-actions {
    width: 340px;
}

.menu-button {
    height: 50px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
    font-size: 14px;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.6);
}

.menu-button:disabled {
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(226, 238, 252, 0.28);
}

.menu-button--primary {
    background-color: rgba(18, 184, 134, 0.16);
    border-color: var(--good);
    color: var(--good);
}

.menu-button--primary:hover {
    background-color: rgba(18, 184, 134, 0.28);
}

.menu-button--danger {
    border-color: rgba(233, 96, 96, 0.55);
    color: var(--bad);
}

.menu-button--quiet {
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--ink-faint);
}

.menu-note {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 14px;
}

/* ---- the decorative console ------------------------------------------- */

.console-card {
    width: 420px;
    background-color: rgba(6, 30, 62, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    padding: 20px;
}

.console-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.console-kicker {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--ink-faint);
}

.console-number {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--good);
}

/* A loss curve drawn as bars, because a real chart would need a mesh and this reads at a glance. */
.loss-chart {
    flex-direction: row;
    align-items: flex-end;
    height: 130px;
    margin-bottom: 16px;
}

.loss-bar {
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(120, 170, 225, 0.32);
    border-top-width: 2px;
    border-top-color: var(--blue-400);
}

.loss-bar--live {
    background-color: rgba(18, 184, 134, 0.30);
    border-top-color: var(--good);
}

.console-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
}

.console-label {
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 1px;
}

.console-value {
    font-size: 12px;
    color: var(--ink-dim);
    -unity-font-style: bold;
}

.rack-row {
    flex-direction: row;
    margin-top: 14px;
    margin-bottom: 12px;
}

.rack-led {
    width: 10px;
    height: 10px;
    margin-right: 5px;
    border-radius: 5px;
    background-color: rgba(120, 170, 225, 0.18);
}

.rack-led--on {
    background-color: var(--good);
}

.console-caption {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--ink-faint);
}

.studio-signature {
    position: absolute;
    left: 90px;
    bottom: 34px;
}

.signature-studio {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink-dim);
}

.signature-author {
    font-size: 11px;
    color: var(--ink-faint);
}

/* ---- settings overlay -------------------------------------------------- */

.settings-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 14, 30, 0.88);
    justify-content: center;
    align-items: center;
}

.settings-sheet {
    width: 620px;
    background-color: var(--blue-800);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 3px;
    padding: 26px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.setting-copy {
    width: 300px;
}

.setting-name {
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
}

.setting-description {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
}

.setting-value {
    width: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* ---- top bar ---------------------------------------------------------- */

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 46px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--blue-900);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.topbar__group {
    flex-direction: row;
    align-items: center;
}

.topbar__stat {
    margin-right: 22px;
    -unity-font-style: bold;
    font-size: 15px;
}

.topbar__stat--muted {
    color: var(--ink-dim);
    -unity-font-style: normal;
}

/* ---- left rail -------------------------------------------------------- */

.shell {
    flex-direction: row;
    flex-grow: 1;
}

.rail {
    width: 252px;
    background-color: var(--rail);
    padding-top: 22px;
    padding-bottom: 22px;
}

.rail__brand {
    font-size: 30px;
    -unity-font-style: bold;
    padding-left: 24px;
    letter-spacing: 2px;
}

.rail__subtitle {
    color: var(--ink-dim);
    padding-left: 24px;
    padding-bottom: 26px;
    font-size: 13px;
}

.rail__item {
    height: 46px;
    padding-left: 24px;
    justify-content: center;
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.rail__item:hover {
    background-color: rgba(120, 170, 225, 0.12);
}

.rail__item--active {
    background-color: var(--rail-active);
    border-left-color: var(--blue-400);
}

/* ---- content ---------------------------------------------------------- */

.content {
    flex-grow: 1;
    padding: 26px;
}

.page-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.page-subtitle {
    color: var(--ink-dim);
    margin-bottom: 20px;
    white-space: normal;
}

/* ---- card grid, the MY OS layout -------------------------------------- */

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.card {
    width: 268px;
    height: 134px;
    margin-right: var(--gutter);
    margin-bottom: var(--gutter);
    border-radius: var(--card-radius);
    background-color: var(--blue-700);
    justify-content: flex-end;
    padding: 14px;
    overflow: hidden;
}

.card:hover {
    background-color: var(--blue-600);
}

.card--locked {
    background-color: var(--locked);
}

.card--behind {
    border-left-width: 4px;
    border-left-color: var(--bad);
}

.card--ahead {
    border-left-width: 4px;
    border-left-color: var(--good);
}

/* ---- card art -------------------------------------------------------- */

/*
 * Photographs are pulled in as a background and then buried under a heavy scrim.
 *
 * The scrim is deliberately strong. Stock photography arrives bright, in the wrong aspect ratio and
 * often covered in printed labels, and none of that survives at 75 percent darkness scaled to fill.
 * What does survive is tone, which is the only thing a card at 268 by 134 was ever going to convey.
 * This is why the art brief says to judge a candidate at the size it will actually appear.
 */
.card--art {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: rgba(70, 90, 120, 0.55);
}

.card--art .card__title,
.card--art .card__line,
.card--art .card__badge {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.card__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 26, 54, 0.62);
}

.card__title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.card__line {
    font-size: 14px;
    color: var(--ink-dim);
}

.card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--ink-faint);
}

/* ---- creator form ----------------------------------------------------- */

.panel {
    background-color: rgba(6, 30, 62, 0.45);
    border-radius: var(--card-radius);
    padding: 18px;
    margin-bottom: 16px;
}

.panel__heading {
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
    color: var(--ink-dim);
    margin-bottom: 12px;
}

.field {
    margin-bottom: 14px;
}

.field__label {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.field__hint {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
}

.readout {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.readout__value {
    -unity-font-style: bold;
}

.readout__value--good { color: var(--good); }
.readout__value--warn { color: var(--warn); }
.readout__value--bad { color: var(--bad); }

.verdict {
    padding: 12px;
    border-radius: var(--card-radius);
    margin-top: 8px;
    white-space: normal;
}

.verdict--ok {
    background-color: rgba(78, 205, 148, 0.14);
    color: var(--good);
}

.verdict--blocked {
    background-color: rgba(233, 96, 96, 0.14);
    color: var(--bad);
}

/* ---- buttons ---------------------------------------------------------- */

.button {
    height: 44px;
    min-width: 190px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.75);
    border-radius: 3px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 2px;
    font-size: 14px;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.button:disabled {
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--ink-faint);
}

.button--primary {
    background-color: var(--blue-600);
    border-color: var(--blue-400);
}

/* ---- bottom toolbar --------------------------------------------------- */

.toolbar {
    flex-direction: row;
    align-items: center;
    height: 58px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--blue-900);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.toolbar__button {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    color: var(--ink);
    -unity-font-style: bold;
}

.toolbar__button:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.toolbar__spacer {
    flex-grow: 1;
}
