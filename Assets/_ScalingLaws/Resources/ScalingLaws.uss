/*
 * Scaling Laws theme.
 *
 * Deliberately a first pass in the visual language of the tycoon games this is modelled on:
 * a deep blue field, a translucent left rail, and a grid of dark photo cards with an uppercase
 * title, a level and a price. Every colour and size in this file is a token. Restyling the whole
 * game later should mean editing this file and dropping in card art, not touching C#.
 *
 * Card art: every .card gets its background from a --card-image variable set in code, so the
 * placeholder blocks below can be swapped for textures without a layout change.
 */

:root {
    --blue-900: rgb(6, 32, 66);
    --blue-800: rgb(9, 45, 90);
    --blue-700: rgb(13, 62, 118);
    --blue-600: rgb(18, 84, 158);
    --blue-400: rgb(56, 138, 220);

    --rail: rgba(6, 30, 62, 0.72);
    --rail-active: rgba(120, 170, 225, 0.22);

    --ink: rgb(255, 255, 255);
    --ink-dim: rgba(226, 238, 252, 0.72);
    --ink-faint: rgba(226, 238, 252, 0.45);

    --good: rgb(78, 205, 148);
    --warn: rgb(240, 186, 78);
    --bad: rgb(233, 96, 96);
    --locked: rgba(10, 24, 44, 0.78);

    --card-radius: 4px;
    --gutter: 16px;
}

.root {
    flex-grow: 1;
    background-color: var(--blue-800);
    color: var(--ink);
    font-size: 14px;
}

/* ---- main menu -------------------------------------------------------- */

/*
 * Structure borrowed from BakaBakeBakery, tone deliberately not.
 *
 * That menu is warm, rounded and inviting because it is about a bakery. This one is about a server
 * room in 2022, so the same skeleton gets hard edges, monospaced numerals, a printed circuit green
 * for anything live, and a decorative panel that is a training run rather than a shop window.
 *
 * The panel on the right is built entirely from styled elements. No image is loaded for it, which
 * is why the menu looked finished before any art existed and will keep working if art never arrives.
 */

.menu-root {
    flex-grow: 1;
    background-color: var(--blue-900);
    justify-content: center;
    padding-left: 90px;
    padding-right: 90px;
}

.menu-layout {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.menu-copy {
    width: 560px;
}

.menu-eyebrow {
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--ink-faint);
    margin-bottom: 18px;
}

.title-lockup {
    margin-bottom: 18px;
}

.title-line {
    font-size: 74px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--ink);
}

.title-line--small {
    font-size: 30px;
    letter-spacing: 12px;
    color: var(--ink-dim);
}

.title-line--accent {
    color: var(--good);
}

.menu-subtitle {
    color: var(--ink-dim);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 34px;
    max-width: 460px;
}

.menu-actions {
    width: 340px;
}

.menu-button {
    height: 50px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
    font-size: 14px;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.6);
}

.menu-button:disabled {
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(226, 238, 252, 0.28);
}

.menu-button--primary {
    background-color: rgba(18, 184, 134, 0.16);
    border-color: var(--good);
    color: var(--good);
}

.menu-button--primary:hover {
    background-color: rgba(18, 184, 134, 0.28);
}

.menu-button--danger {
    border-color: rgba(233, 96, 96, 0.55);
    color: var(--bad);
}

.menu-button--quiet {
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--ink-faint);
}

.menu-note {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 14px;
}

/* ---- the decorative console ------------------------------------------- */

.console-card {
    width: 420px;
    background-color: rgba(6, 30, 62, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    padding: 20px;
}

.console-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.console-kicker {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--ink-faint);
}

.console-number {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--good);
}

/* A loss curve drawn as bars, because a real chart would need a mesh and this reads at a glance. */
.loss-chart {
    flex-direction: row;
    align-items: flex-end;
    height: 130px;
    margin-bottom: 16px;
}

.loss-bar {
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(120, 170, 225, 0.32);
    border-top-width: 2px;
    border-top-color: var(--blue-400);
}

.loss-bar--live {
    background-color: rgba(18, 184, 134, 0.30);
    border-top-color: var(--good);
}

.console-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
}

.console-label {
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 1px;
}

.console-value {
    font-size: 12px;
    color: var(--ink-dim);
    -unity-font-style: bold;
}

.rack-row {
    flex-direction: row;
    margin-top: 14px;
    margin-bottom: 12px;
}

.rack-led {
    width: 10px;
    height: 10px;
    margin-right: 5px;
    border-radius: 5px;
    background-color: rgba(120, 170, 225, 0.18);
}

.rack-led--on {
    background-color: var(--good);
}

.console-caption {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--ink-faint);
}

.studio-signature {
    position: absolute;
    left: 90px;
    bottom: 34px;
}

.signature-studio {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink-dim);
}

.signature-author {
    font-size: 11px;
    color: var(--ink-faint);
}

/* ---- settings overlay -------------------------------------------------- */

.settings-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 14, 30, 0.88);
    justify-content: center;
    align-items: center;
}

.settings-sheet {
    width: 620px;
    background-color: var(--blue-800);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 3px;
    padding: 26px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.setting-copy {
    width: 300px;
}

.setting-name {
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
}

.setting-description {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
}

.setting-value {
    width: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* ---- top bar ---------------------------------------------------------- */

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 46px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--blue-900);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.topbar__group {
    flex-direction: row;
    align-items: center;
}

.topbar__stat {
    margin-right: 22px;
    -unity-font-style: bold;
    font-size: 15px;
}

.topbar__stat--muted {
    color: var(--ink-dim);
    -unity-font-style: normal;
}

/* ---- left rail -------------------------------------------------------- */

.shell {
    flex-direction: row;
    flex-grow: 1;
}

.rail {
    width: 252px;
    background-color: var(--rail);
    padding-top: 22px;
    padding-bottom: 22px;
}

.rail__brand {
    font-size: 30px;
    -unity-font-style: bold;
    padding-left: 24px;
    letter-spacing: 2px;
}

.rail__subtitle {
    color: var(--ink-dim);
    padding-left: 24px;
    padding-bottom: 26px;
    font-size: 13px;
}

.rail__item {
    height: 46px;
    padding-left: 24px;
    justify-content: center;
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.rail__item:hover {
    background-color: rgba(120, 170, 225, 0.12);
}

.rail__item--active {
    background-color: var(--rail-active);
    border-left-color: var(--blue-400);
}

/* ---- content ---------------------------------------------------------- */

.content {
    flex-grow: 1;
    padding: 26px;
}

.page-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.page-subtitle {
    color: var(--ink-dim);
    margin-bottom: 20px;
    white-space: normal;
}

/* ---- card grid, the MY OS layout -------------------------------------- */

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.card {
    width: 268px;
    height: 134px;
    margin-right: var(--gutter);
    margin-bottom: var(--gutter);
    border-radius: var(--card-radius);
    background-color: var(--blue-700);
    justify-content: flex-end;
    padding: 14px;
    overflow: hidden;
}

.card:hover {
    background-color: var(--blue-600);
}

.card--locked {
    background-color: var(--locked);
}

.card--behind {
    border-left-width: 4px;
    border-left-color: var(--bad);
}

.card--ahead {
    border-left-width: 4px;
    border-left-color: var(--good);
}

/* ---- card art -------------------------------------------------------- */

/*
 * Photographs are pulled in as a background and then buried under a heavy scrim.
 *
 * The scrim is deliberately strong. Stock photography arrives bright, in the wrong aspect ratio and
 * often covered in printed labels, and none of that survives at 75 percent darkness scaled to fill.
 * What does survive is tone, which is the only thing a card at 268 by 134 was ever going to convey.
 * This is why the art brief says to judge a candidate at the size it will actually appear.
 */
.card--art {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: rgba(70, 90, 120, 0.55);
}

.card--art .card__title,
.card--art .card__line,
.card--art .card__badge {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.card__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 26, 54, 0.62);
}

.card__title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.card__line {
    font-size: 14px;
    color: var(--ink-dim);
}

.card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--ink-faint);
}

/* ---- creator form ----------------------------------------------------- */

.panel {
    background-color: rgba(6, 30, 62, 0.45);
    border-radius: var(--card-radius);
    padding: 18px;
    margin-bottom: 16px;
}

.panel__heading {
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
    color: var(--ink-dim);
    margin-bottom: 12px;
}

.field {
    margin-bottom: 14px;
}

.field__label {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.field__hint {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
}

.readout {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.readout__value {
    -unity-font-style: bold;
}

.readout__value--good { color: var(--good); }
.readout__value--warn { color: var(--warn); }
.readout__value--bad { color: var(--bad); }

.verdict {
    padding: 12px;
    border-radius: var(--card-radius);
    margin-top: 8px;
    white-space: normal;
}

.verdict--ok {
    background-color: rgba(78, 205, 148, 0.14);
    color: var(--good);
}

.verdict--blocked {
    background-color: rgba(233, 96, 96, 0.14);
    color: var(--bad);
}

/* ---- buttons ---------------------------------------------------------- */

.button {
    height: 44px;
    min-width: 190px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.75);
    border-radius: 3px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 2px;
    font-size: 14px;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.button:disabled {
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--ink-faint);
}

.button--primary {
    background-color: var(--blue-600);
    border-color: var(--blue-400);
}

/* ---- bottom toolbar --------------------------------------------------- */

.toolbar {
    flex-direction: row;
    align-items: center;
    height: 58px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--blue-900);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.toolbar__button {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    color: var(--ink);
    -unity-font-style: bold;
}

.toolbar__button:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.toolbar__spacer {
    flex-grow: 1;
}

/* ---------------------------------------------------------------------------
   Creator pages: who you are, and which lab.

   Every block below sets flex-shrink: 0. Both pages are taller than the window,
   and the first version let them squash instead of scroll, which pushed the
   skill bars up onto their own titles and cut the second row of traits off the
   bottom of the screen.
   --------------------------------------------------------------------------- */

.page-scroll {
    flex-grow: 1;
    width: 100%;
}

.creator {
    width: 1340px;
    flex-shrink: 0;
    align-self: center;
}

.creator__columns {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 8px;
}

/* The page has to fit without scrolling, so the title gives back what it can. */

.creator > .page-title {
    font-size: 26px;
    margin-bottom: 2px;
}

.creator__identity {
    width: 320px;
    flex-shrink: 0;
    margin-right: 12px;
    padding: 16px;
    background-color: rgb(22, 26, 34);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
}

.creator__line {
    font-size: 17px;
    color: rgb(150, 162, 180);
    margin-bottom: 6px;
}

.creator__name {
    margin-bottom: 12px;
    flex-shrink: 0;
}

.creator__name > .unity-text-field__input {
    height: 40px;
    font-size: 18px;
    padding-left: 10px;
    background-color: rgb(12, 15, 20);
    border-width: 1px;
    border-color: rgb(64, 122, 196);
    border-radius: 4px;
    color: rgb(226, 233, 244);
}

/* Takes every pixel the name field did not, so the card never ends in dead space. */

.portrait {
    flex-grow: 1;
    min-height: 250px;
    background-color: rgb(13, 16, 22);
    border-width: 1px;
    border-color: rgb(52, 62, 78);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.portrait__label {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(74, 86, 104);
    -unity-font-style: bold;
}

.creator__skills {
    flex-grow: 1;
    flex-shrink: 0;
    padding: 14px;
    background-color: rgb(22, 26, 34);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
}

.skills-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.skills-budget {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(112, 196, 132);
}

.skills-budget--spent {
    color: rgb(120, 132, 150);
}

/* Four on the left, three on the right. Seven in one stack does not fit the page. */

.skills-split {
    flex-direction: row;
    flex-shrink: 0;
}

.skills-split__column {
    width: 50%;
    flex-shrink: 0;
}

.skills-split__column--right {
    padding-left: 8px;
}

/* Icon, text, controls. Three columns that cannot collide. */

.skill-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 9px;
    padding-right: 9px;
    background-color: rgb(17, 20, 27);
    border-radius: 4px;
}

.skill-icon {
    flex-shrink: 0;
    margin-right: 9px;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-icon--missing {
    background-color: rgb(28, 34, 44);
    border-radius: 4px;
}

.skill-row__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.skill-row__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(206, 216, 230);
    letter-spacing: 1px;
}

.skill-track {
    height: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
    background-color: rgb(10, 12, 16);
    border-radius: 3px;
    overflow: hidden;
}

.skill-track__fill {
    height: 6px;
    background-color: rgb(64, 122, 196);
}

.skill-track__fill--lowered {
    background-color: rgb(168, 82, 82);
}

/* A tick where every skill started, so a level reads as a distance from it. */

.skill-track__baseline {
    position: absolute;
    top: 0;
    width: 1px;
    height: 6px;
    background-color: rgb(96, 112, 134);
}

.skill-row__effect {
    font-size: 11px;
    color: rgb(122, 134, 152);
    white-space: nowrap;
    overflow: hidden;
}

.skill-row__controls {
    width: 88px;
    flex-shrink: 0;
    margin-left: 8px;
    align-items: flex-end;
}

.skill-row__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(160, 172, 190);
    margin-bottom: 4px;
}

.skill-row__value--raised {
    color: rgb(112, 196, 132);
}

.skill-row__value--lowered {
    color: rgb(214, 106, 106);
}

.skill-row__buttons {
    flex-direction: row;
}

.skill-button {
    width: 32px;
    height: 24px;
    margin-left: 5px;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgb(34, 42, 54);
    border-width: 1px;
    border-color: rgb(58, 70, 88);
    border-radius: 3px;
    color: rgb(214, 224, 238);
}

.skill-button:hover {
    background-color: rgb(48, 62, 82);
    border-color: rgb(78, 98, 124);
}

.skill-button:disabled {
    opacity: 0.3;
}

/* ---- traits: four per row, compact ---- */

.traits {
    flex-shrink: 0;
}

/* Heading and instruction share a line. Two lines of chrome above eight cards is
   height the page does not have to spend. */

.traits__header {
    flex-direction: row;
    align-items: baseline;
}

.traits__header > .field__hint {
    margin-left: 12px;
}

.traits__header > .panel__heading {
    margin-bottom: 0;
}

/* The skills panel heading carries the same 12px gap and does not need it here either. */

.creator__skills .panel__heading {
    margin-bottom: 0;
}

.trait-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 6px;
}

.trait-card {
    width: 326px;
    flex-shrink: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 0;
    background-color: rgb(20, 24, 31);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 5px;
    align-items: stretch;
    overflow: hidden;
}

.trait-card:hover {
    border-color: rgb(74, 92, 118);
}

.trait-card--picked {
    border-color: rgb(78, 142, 220);
    background-color: rgb(24, 33, 48);
}

.trait-card--locked {
    opacity: 0.38;
}

.trait-card__title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(228, 236, 248);
    letter-spacing: 1px;
    padding-top: 9px;
    padding-left: 10px;
    padding-right: 10px;
}

.trait-card__flavour {
    font-size: 11px;
    color: rgb(124, 136, 154);
    white-space: normal;
    padding-top: 3px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 6px;
    height: 30px;
}

/* Its own shade so the numbers read as data, not as more prose. */

.trait-effects {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(31, 38, 49);
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
}

.trait-card--picked .trait-effects {
    background-color: rgb(33, 45, 64);
}

.trait-effects__row {
    flex-direction: row;
    justify-content: space-between;
}

.trait-effects__label {
    font-size: 11px;
    color: rgb(142, 154, 172);
}

.trait-effects__value {
    font-size: 11px;
    -unity-font-style: bold;
}

.trait-effects__value--good {
    color: rgb(112, 200, 136);
}

.trait-effects__value--bad {
    color: rgb(220, 108, 108);
}

.trait-card__badge {
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(14, 20, 30);
    background-color: rgb(78, 142, 220);
    -unity-text-align: middle-center;
}

/* ---- footer ---- */

.creator-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    margin-top: 8px;
}

.creator-footer__reason {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(196, 156, 96);
}

/* ---- your lab: tiles and the banner are one block ---- */

.lab-block {
    flex-shrink: 0;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
    overflow: hidden;
}

.lab-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.lab-card {
    width: 25%;
    flex-shrink: 0;
    margin: 0;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(20, 24, 31);
    border-width: 0;
    border-left-width: 1px;
    border-color: rgb(40, 48, 60);
    border-radius: 0;
    align-items: center;
}

.lab-card:hover {
    background-color: rgb(27, 34, 44);
}

.lab-card--on {
    background-color: rgb(27, 40, 60);
}

.lab-mark {
    font-size: 30px;
    -unity-font-style: bold;
}

.lab-card__name {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(228, 236, 248);
    margin-top: 4px;
}

.lab-card__line {
    font-size: 11px;
    color: rgb(128, 140, 158);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 3px;
}

.lab-banner {
    margin: 0;
    padding-top: 11px;
    padding-bottom: 11px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(196, 214, 240);
    background-color: rgb(27, 34, 46);
    border-width: 0;
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
    border-radius: 0;
}

.lab-banner:hover {
    background-color: rgb(34, 44, 60);
}

.lab-banner--on {
    background-color: rgb(30, 48, 74);
    color: rgb(226, 238, 255);
}

/* ---- region: map, list and the four numbers, joined ---- */

.region {
    flex-shrink: 0;
    margin-top: 14px;
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
    overflow: hidden;
}

.region__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(22, 26, 34);
}

.region__chosen {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(120, 176, 250);
}

.region__body {
    flex-direction: row;
    background-color: rgb(18, 22, 29);
}

.world-map {
    flex-grow: 1;
    height: 330px;
    border-right-width: 1px;
    border-color: rgb(40, 48, 60);
}

.world-map__pick {
    margin: 0;
    padding: 0;
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(180, 205, 240, 0.55);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: lower-center;
}

.world-map__pick:hover {
    color: rgb(226, 238, 255);
    background-color: rgba(90, 150, 230, 0.10);
}

.world-map__pick--on {
    color: rgb(226, 238, 255);
}

.region__list {
    width: 280px;
    flex-shrink: 0;
    padding: 12px;
}

.region__list-title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(226, 233, 244);
}

.country {
    margin: 0;
    margin-top: 4px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    color: rgb(190, 202, 218);
    background-color: rgb(24, 30, 39);
    border-width: 1px;
    border-color: rgb(42, 52, 66);
    border-radius: 4px;
    -unity-text-align: middle-left;
}

.country:hover {
    background-color: rgb(32, 42, 56);
}

.country--on {
    background-color: rgb(30, 52, 82);
    border-color: rgb(78, 142, 220);
    color: rgb(232, 242, 255);
}

/* Different shade, joined to the body above it with no gap. */

.region-effects {
    padding-top: 10px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(28, 34, 45);
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
}

.region-effects__caption {
    font-size: 11px;
    color: rgb(138, 150, 168);
    margin-bottom: 8px;
    white-space: normal;
}

.region-effects__row {
    flex-direction: row;
}

.region-tile {
    width: 25%;
    padding-right: 12px;
}

.region-tile__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(130, 144, 164);
}

.region-tile__value {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(214, 224, 238);
    margin-top: 2px;
    margin-bottom: 2px;
}

.region-tile__value--good {
    color: rgb(112, 200, 136);
}

.region-tile__value--bad {
    color: rgb(220, 108, 108);
}

.region-tile__note {
    font-size: 10px;
    color: rgb(112, 124, 142);
    white-space: normal;
}
