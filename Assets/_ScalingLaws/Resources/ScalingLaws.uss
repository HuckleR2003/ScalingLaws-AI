/*
 * Scaling Laws theme.
 *
 * Deliberately a first pass in the visual language of the tycoon games this is modelled on:
 * a deep blue field, a translucent left rail, and a grid of dark photo cards with an uppercase
 * title, a level and a price. Every colour and size in this file is a token. Restyling the whole
 * game later should mean editing this file and dropping in card art, not touching C#.
 *
 * Card art: every .card gets its background from a --card-image variable set in code, so the
 * placeholder blocks below can be swapped for textures without a layout change.
 */

:root {
    --blue-900: rgb(6, 32, 66);
    --blue-800: rgb(9, 45, 90);
    --blue-700: rgb(13, 62, 118);
    --blue-600: rgb(18, 84, 158);
    --blue-400: rgb(56, 138, 220);

    --rail: rgba(6, 30, 62, 0.72);
    --rail-active: rgba(120, 170, 225, 0.22);

    --ink: rgb(255, 255, 255);
    --ink-dim: rgba(226, 238, 252, 0.72);
    --ink-faint: rgba(226, 238, 252, 0.45);

    --good: rgb(78, 205, 148);
    --warn: rgb(240, 186, 78);
    --bad: rgb(233, 96, 96);
    --locked: rgba(10, 24, 44, 0.78);

    --card-radius: 4px;
    --gutter: 16px;
}

.root {
    flex-grow: 1;
    background-color: var(--blue-800);
    color: var(--ink);
    font-size: 14px;
}

/* ---- main menu -------------------------------------------------------- */

/*
 * Structure borrowed from BakaBakeBakery, tone deliberately not.
 *
 * That menu is warm, rounded and inviting because it is about a bakery. This one is about a server
 * room in 2022, so the same skeleton gets hard edges, monospaced numerals, a printed circuit green
 * for anything live, and a decorative panel that is a training run rather than a shop window.
 *
 * The panel on the right is built entirely from styled elements. No image is loaded for it, which
 * is why the menu looked finished before any art existed and will keep working if art never arrives.
 */

.menu-root {
    flex-grow: 1;
    background-color: var(--blue-900);
    justify-content: center;
    padding-left: 90px;
    padding-right: 90px;
}

.menu-layout {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.menu-copy {
    width: 560px;
}

.menu-eyebrow {
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--ink-faint);
    margin-bottom: 18px;
}

.title-lockup {
    margin-bottom: 18px;
}

.title-line {
    font-size: 74px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--ink);
}

.title-line--small {
    font-size: 30px;
    letter-spacing: 12px;
    color: var(--ink-dim);
}

.title-line--accent {
    color: var(--good);
}

.menu-subtitle {
    color: var(--ink-dim);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 34px;
    max-width: 460px;
}

.menu-actions {
    width: 340px;
}

.menu-button {
    height: 50px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
    font-size: 14px;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.6);
}

.menu-button:disabled {
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(226, 238, 252, 0.28);
}

.menu-button--primary {
    background-color: rgba(18, 184, 134, 0.16);
    border-color: var(--good);
    color: var(--good);
}

.menu-button--primary:hover {
    background-color: rgba(18, 184, 134, 0.28);
}

.menu-button--danger {
    border-color: rgba(233, 96, 96, 0.55);
    color: var(--bad);
}

.menu-button--quiet {
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--ink-faint);
}

.menu-note {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 14px;
}

/* ---- the decorative console ------------------------------------------- */

.console-card {
    width: 420px;
    background-color: rgba(6, 30, 62, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    padding: 20px;
}

.console-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.console-kicker {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--ink-faint);
}

.console-number {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--good);
}

/* A loss curve drawn as bars, because a real chart would need a mesh and this reads at a glance. */
.loss-chart {
    flex-direction: row;
    align-items: flex-end;
    height: 130px;
    margin-bottom: 16px;
}

.loss-bar {
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(120, 170, 225, 0.32);
    border-top-width: 2px;
    border-top-color: var(--blue-400);
}

.loss-bar--live {
    background-color: rgba(18, 184, 134, 0.30);
    border-top-color: var(--good);
}

.console-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
}

.console-label {
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 1px;
}

.console-value {
    font-size: 12px;
    color: var(--ink-dim);
    -unity-font-style: bold;
}

.rack-row {
    flex-direction: row;
    margin-top: 14px;
    margin-bottom: 12px;
}

.rack-led {
    width: 10px;
    height: 10px;
    margin-right: 5px;
    border-radius: 5px;
    background-color: rgba(120, 170, 225, 0.18);
}

.rack-led--on {
    background-color: var(--good);
}

.console-caption {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--ink-faint);
}

.studio-signature {
    position: absolute;
    left: 90px;
    bottom: 34px;
}

.signature-studio {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink-dim);
}

.signature-author {
    font-size: 11px;
    color: var(--ink-faint);
}

/* ---- settings overlay -------------------------------------------------- */

.settings-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 14, 30, 0.88);
    justify-content: center;
    align-items: center;
}

.settings-sheet {
    width: 620px;
    background-color: var(--blue-800);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 3px;
    padding: 26px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.setting-copy {
    width: 300px;
}

.setting-name {
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
}

.setting-description {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
}

.setting-value {
    width: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* ---- top bar ---------------------------------------------------------- */

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 46px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--blue-900);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.topbar__group {
    flex-direction: row;
    align-items: center;
}

.topbar__stat {
    margin-right: 22px;
    -unity-font-style: bold;
    font-size: 15px;
}

.topbar__stat--muted {
    color: var(--ink-dim);
    -unity-font-style: normal;
}

/* ---- left rail -------------------------------------------------------- */

.shell {
    flex-direction: row;
    flex-grow: 1;
}

.rail {
    width: 252px;
    background-color: var(--rail);
    padding-top: 22px;
    padding-bottom: 22px;
}

.rail__brand {
    font-size: 30px;
    -unity-font-style: bold;
    padding-left: 24px;
    letter-spacing: 2px;
}

.rail__subtitle {
    color: var(--ink-dim);
    padding-left: 24px;
    padding-bottom: 26px;
    font-size: 13px;
}

.rail__item {
    height: 46px;
    padding-left: 24px;
    justify-content: center;
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.rail__item:hover {
    background-color: rgba(120, 170, 225, 0.12);
}

.rail__item--active {
    background-color: var(--rail-active);
    border-left-color: var(--blue-400);
}

/* ---- content ---------------------------------------------------------- */

.content {
    flex-grow: 1;
    padding: 26px;
}

.page-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.page-subtitle {
    color: var(--ink-dim);
    margin-bottom: 20px;
    white-space: normal;
}

/* ---- card grid, the MY OS layout -------------------------------------- */

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.card {
    width: 268px;
    height: 134px;
    margin-right: var(--gutter);
    margin-bottom: var(--gutter);
    border-radius: var(--card-radius);
    background-color: var(--blue-700);
    justify-content: flex-end;
    padding: 14px;
    overflow: hidden;
}

.card:hover {
    background-color: var(--blue-600);
}

.card--locked {
    background-color: var(--locked);
}

.card--behind {
    border-left-width: 4px;
    border-left-color: var(--bad);
}

.card--ahead {
    border-left-width: 4px;
    border-left-color: var(--good);
}

/* ---- card art -------------------------------------------------------- */

/*
 * Photographs are pulled in as a background and then buried under a heavy scrim.
 *
 * The scrim is deliberately strong. Stock photography arrives bright, in the wrong aspect ratio and
 * often covered in printed labels, and none of that survives at 75 percent darkness scaled to fill.
 * What does survive is tone, which is the only thing a card at 268 by 134 was ever going to convey.
 * This is why the art brief says to judge a candidate at the size it will actually appear.
 */
.card--art {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: rgba(70, 90, 120, 0.55);
}

.card--art .card__title,
.card--art .card__line,
.card--art .card__badge {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.card__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 26, 54, 0.62);
}

.card__title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.card__line {
    font-size: 14px;
    color: var(--ink-dim);
}

.card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--ink-faint);
}

/* ---- creator form ----------------------------------------------------- */

.panel {
    background-color: rgba(6, 30, 62, 0.45);
    border-radius: var(--card-radius);
    padding: 18px;
    margin-bottom: 16px;

    /* UI Toolkit shrinks children before it overflows them. Without this the two panels below
       the Scale belt were squashed to nothing and the whole SCALING READOUT section was invisible
       on screen while every test passed. The belt survived only because it already said 0. */
    flex-shrink: 0;
}

/* A stage that stacks several panels. Stated because it was referenced from C# before it existed
   here at all, which is what let the shrink above go unnoticed. */

.creator-column {
    flex-grow: 1;
    flex-shrink: 0;
}

/* The Scale stage carries four blocks, so it buys the room back from its own padding. */

.creator-column > .panel {
    padding: 12px;
    margin-bottom: 8px;
}

.panel__heading {
    -unity-font-style: bold;
    letter-spacing: 1px;
    font-size: 13px;
    color: var(--ink-dim);
    margin-bottom: 12px;
}

.field {
    margin-bottom: 14px;
}

.field__label {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.field__hint {
    color: var(--ink-faint);
    font-size: 12px;
    white-space: normal;
}

.readout {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.readout__value {
    -unity-font-style: bold;
}

.readout__value--good { color: var(--good); }
.readout__value--warn { color: var(--warn); }
.readout__value--bad { color: var(--bad); }

.verdict {
    padding: 12px;
    border-radius: var(--card-radius);
    margin-top: 8px;
    white-space: normal;
}

.verdict--ok {
    background-color: rgba(78, 205, 148, 0.14);
    color: var(--good);
}

.verdict--blocked {
    background-color: rgba(233, 96, 96, 0.14);
    color: var(--bad);
}

/* ---- buttons ---------------------------------------------------------- */

.button {
    height: 44px;
    min-width: 190px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.75);
    border-radius: 3px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 2px;
    font-size: 14px;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.button:disabled {
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--ink-faint);
}

.button--primary {
    background-color: var(--blue-600);
    border-color: var(--blue-400);
}

/* ---- bottom toolbar --------------------------------------------------- */

.toolbar {
    flex-direction: row;
    align-items: center;
    height: 58px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--blue-900);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.toolbar__button {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    color: var(--ink);
    -unity-font-style: bold;
}

.toolbar__button:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.toolbar__spacer {
    flex-grow: 1;
}

/* ---------------------------------------------------------------------------
   Creator pages: who you are, and which lab.

   Every block below sets flex-shrink: 0. Both pages are taller than the window,
   and the first version let them squash instead of scroll, which pushed the
   skill bars up onto their own titles and cut the second row of traits off the
   bottom of the screen.
   --------------------------------------------------------------------------- */

.page-scroll {
    flex-grow: 1;
    width: 100%;
}

.creator {
    width: 1340px;
    flex-shrink: 0;
    align-self: center;
}

.creator__columns {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 8px;
}

/* The page has to fit without scrolling, so the title gives back what it can. */

.creator > .page-title {
    font-size: 26px;
    margin-bottom: 2px;
}

.creator__identity {
    width: 320px;
    flex-shrink: 0;
    margin-right: 12px;
    padding: 16px;
    background-color: rgb(22, 26, 34);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
}

.creator__line {
    font-size: 17px;
    color: rgb(150, 162, 180);
    margin-bottom: 6px;
}

.creator__name {
    margin-bottom: 12px;
    flex-shrink: 0;
}

.creator__name > .unity-text-field__input {
    height: 40px;
    font-size: 18px;
    padding-left: 10px;
    background-color: rgb(12, 15, 20);
    border-width: 1px;
    border-color: rgb(64, 122, 196);
    border-radius: 4px;
    color: rgb(226, 233, 244);
}

/* Takes every pixel the name field did not, so the card never ends in dead space. */

.portrait {
    flex-grow: 1;
    min-height: 250px;
    background-color: rgb(13, 16, 22);
    border-width: 1px;
    border-color: rgb(52, 62, 78);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.portrait__label {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(74, 86, 104);
    -unity-font-style: bold;
}

.creator__skills {
    flex-grow: 1;
    flex-shrink: 0;
    padding: 14px;
    background-color: rgb(22, 26, 34);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
}

.skills-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.skills-budget {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(112, 196, 132);
}

.skills-budget--spent {
    color: rgb(120, 132, 150);
}

/* Four on the left, three on the right. Seven in one stack does not fit the page. */

.skills-split {
    flex-direction: row;
    flex-shrink: 0;
}

.skills-split__column {
    width: 50%;
    flex-shrink: 0;
}

.skills-split__column--right {
    padding-left: 8px;
}

/* Icon, text, controls. Three columns that cannot collide. */

.skill-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 9px;
    padding-right: 9px;
    background-color: rgb(17, 20, 27);
    border-radius: 4px;
}

.skill-icon {
    flex-shrink: 0;
    margin-right: 9px;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-icon--missing {
    background-color: rgb(28, 34, 44);
    border-radius: 4px;
}

.skill-row__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.skill-row__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(206, 216, 230);
    letter-spacing: 1px;
}

.skill-track {
    height: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
    background-color: rgb(10, 12, 16);
    border-radius: 3px;
    overflow: hidden;
}

.skill-track__fill {
    height: 6px;
    background-color: rgb(64, 122, 196);
}

.skill-track__fill--lowered {
    background-color: rgb(168, 82, 82);
}

/* A tick where every skill started, so a level reads as a distance from it. */

.skill-track__baseline {
    position: absolute;
    top: 0;
    width: 1px;
    height: 6px;
    background-color: rgb(96, 112, 134);
}

.skill-row__effect {
    font-size: 11px;
    color: rgb(122, 134, 152);
    white-space: nowrap;
    overflow: hidden;
}

.skill-row__controls {
    width: 88px;
    flex-shrink: 0;
    margin-left: 8px;
    align-items: flex-end;
}

.skill-row__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(160, 172, 190);
    margin-bottom: 4px;
}

.skill-row__value--raised {
    color: rgb(112, 196, 132);
}

.skill-row__value--lowered {
    color: rgb(214, 106, 106);
}

.skill-row__buttons {
    flex-direction: row;
}

.skill-button {
    width: 32px;
    height: 24px;
    margin-left: 5px;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgb(34, 42, 54);
    border-width: 1px;
    border-color: rgb(58, 70, 88);
    border-radius: 3px;
    color: rgb(214, 224, 238);
}

.skill-button:hover {
    background-color: rgb(48, 62, 82);
    border-color: rgb(78, 98, 124);
}

.skill-button:disabled {
    opacity: 0.3;
}

/* ---- traits: four per row, compact ---- */

.traits {
    flex-shrink: 0;
}

/* Heading and instruction share a line. Two lines of chrome above eight cards is
   height the page does not have to spend. */

.traits__header {
    flex-direction: row;
    align-items: baseline;
}

.traits__header > .field__hint {
    margin-left: 12px;
}

.traits__header > .panel__heading {
    margin-bottom: 0;
}

/* The skills panel heading carries the same 12px gap and does not need it here either. */

.creator__skills .panel__heading {
    margin-bottom: 0;
}

/* The block is the grid plus the banner, joined the same way the lab tiles are. */

.trait-block {
    flex-shrink: 0;
    margin-top: 6px;
    background-color: rgb(14, 17, 23);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
    overflow: hidden;
}

.trait-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 6px;
    padding-left: 6px;
}

/* margin-left has to be stated. The runtime theme puts a margin on every Button, and
   inheriting it made four cards 1352px wide against a 1340px page, so the fourth wrapped
   to a row of its own and the grid quietly became three across. */

.trait-card {
    width: 322px;
    flex-shrink: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 0;
    background-color: rgb(20, 24, 31);
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 5px;
    align-items: stretch;
    overflow: hidden;
}

.trait-card:hover {
    border-color: rgb(74, 92, 118);
}

.trait-card--picked {
    border-color: rgb(78, 142, 220);
    background-color: rgb(24, 33, 48);
}

.trait-card--locked {
    opacity: 0.38;
}

.trait-card__title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(228, 236, 248);
    letter-spacing: 1px;
    padding-top: 9px;
    padding-left: 10px;
    padding-right: 10px;
}

.trait-card__flavour {
    font-size: 11px;
    color: rgb(124, 136, 154);
    white-space: normal;
    padding-top: 3px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 6px;
    height: 30px;
}

/* Its own shade so the numbers read as data, not as more prose. */

.trait-effects {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(31, 38, 49);
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
}

.trait-card--picked .trait-effects {
    background-color: rgb(33, 45, 64);
}

.trait-effects__row {
    flex-direction: row;
    justify-content: space-between;
}

.trait-effects__label {
    font-size: 11px;
    color: rgb(142, 154, 172);
}

.trait-effects__value {
    font-size: 11px;
    -unity-font-style: bold;
}

.trait-effects__value--good {
    color: rgb(112, 200, 136);
}

.trait-effects__value--bad {
    color: rgb(220, 108, 108);
}

.trait-banner {
    margin: 0;
    padding-top: 9px;
    padding-bottom: 9px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(158, 180, 212);
    background-color: rgb(27, 34, 46);
    border-width: 0;
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
    border-radius: 0;
}

.trait-banner:hover {
    background-color: rgb(34, 44, 60);
    color: rgb(226, 238, 255);
}

.trait-banner:disabled {
    opacity: 0.4;
}

.trait-card__badge {
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(14, 20, 30);
    background-color: rgb(78, 142, 220);
    -unity-text-align: middle-center;
}

/* ---- footer ---- */

.creator-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    margin-top: 8px;
}

.creator-footer__reason {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(196, 156, 96);
}

/* ---- your lab: tiles and the banner are one block ---- */

.lab-block {
    flex-shrink: 0;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
    overflow: hidden;
}

.lab-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.lab-card {
    width: 25%;
    flex-shrink: 0;
    margin: 0;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(20, 24, 31);
    border-width: 0;
    border-left-width: 1px;
    border-color: rgb(40, 48, 60);
    border-radius: 0;
    align-items: center;
}

.lab-card:hover {
    background-color: rgb(27, 34, 44);
}

.lab-card--on {
    background-color: rgb(27, 40, 60);
}

.lab-mark {
    font-size: 30px;
    -unity-font-style: bold;
}

.lab-card__name {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(228, 236, 248);
    margin-top: 4px;
}

.lab-card__line {
    font-size: 11px;
    color: rgb(128, 140, 158);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 3px;
}

.lab-banner {
    margin: 0;
    padding-top: 11px;
    padding-bottom: 11px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(196, 214, 240);
    background-color: rgb(27, 34, 46);
    border-width: 0;
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
    border-radius: 0;
}

.lab-banner:hover {
    background-color: rgb(34, 44, 60);
}

.lab-banner--on {
    background-color: rgb(30, 48, 74);
    color: rgb(226, 238, 255);
}

/* ---- region: map, list and the four numbers, joined ---- */

.region {
    flex-shrink: 0;
    margin-top: 14px;
    border-width: 1px;
    border-color: rgb(44, 52, 66);
    border-radius: 6px;
    overflow: hidden;
}

.region__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(22, 26, 34);
}

.region__chosen {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(120, 176, 250);
}

.region__body {
    flex-direction: row;
    background-color: rgb(18, 22, 29);
}

.world-map {
    flex-grow: 1;
    height: 330px;
    border-right-width: 1px;
    border-color: rgb(40, 48, 60);
}

.world-map__pick {
    margin: 0;
    padding: 0;
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(180, 205, 240, 0.55);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: lower-center;
}

.world-map__pick:hover {
    color: rgb(226, 238, 255);
    background-color: rgba(90, 150, 230, 0.10);
}

.world-map__pick--on {
    color: rgb(226, 238, 255);
}

.region__list {
    width: 280px;
    flex-shrink: 0;
    padding: 12px;
}

.region__list-title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(226, 233, 244);
}

.country {
    margin: 0;
    margin-top: 4px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    color: rgb(190, 202, 218);
    background-color: rgb(24, 30, 39);
    border-width: 1px;
    border-color: rgb(42, 52, 66);
    border-radius: 4px;
    -unity-text-align: middle-left;
}

.country:hover {
    background-color: rgb(32, 42, 56);
}

.country--on {
    background-color: rgb(30, 52, 82);
    border-color: rgb(78, 142, 220);
    color: rgb(232, 242, 255);
}

/* Different shade, joined to the body above it with no gap. */

.region-effects {
    padding-top: 10px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(28, 34, 45);
    border-top-width: 1px;
    border-color: rgb(46, 56, 70);
}

.region-effects__caption {
    font-size: 11px;
    color: rgb(138, 150, 168);
    margin-bottom: 8px;
    white-space: normal;
}

.region-effects__row {
    flex-direction: row;
}

.region-tile {
    width: 25%;
    padding-right: 12px;
}

.region-tile__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(130, 144, 164);
}

.region-tile__value {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(214, 224, 238);
    margin-top: 2px;
    margin-bottom: 2px;
}

.region-tile__value--good {
    color: rgb(112, 200, 136);
}

.region-tile__value--bad {
    color: rgb(220, 108, 108);
}

.region-tile__note {
    font-size: 10px;
    color: rgb(112, 124, 142);
    white-space: normal;
}

/* ---------------------------------------------------------------------------
   The bottom interface.

   Almost all of it is black, graphite and soft white. The accent only ever
   appears as a thin line: the contour of the dial, the underline of the
   selected category, and the day bar along the very bottom edge. Those are
   slices of one gradient, which is what makes them read as a single system
   rather than as three red things.
   --------------------------------------------------------------------------- */

.hud {
    flex-shrink: 0;
}

.hud__bar {
    flex-direction: row;
    align-items: flex-end;
    height: 82px;
    padding-left: 6px;
    padding-right: 22px;
    background-color: rgba(9, 10, 13, 0.90);
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

/* ---- the time module ---- */

.hud-time {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 100%;
}

/* Zero width and height so the disc can hang above the bar without anything
   in the row making room for it. */

.hud-time__overhang {
    width: 0;
    height: 0;
    align-items: flex-start;
    justify-content: flex-end;
}

.hud-dial {
    position: absolute;
    left: 24px;
    bottom: 30px;
    width: 148px;
    height: 74px;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 6px;
}

.hud-time__date {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(150, 160, 178);
}

.hud-time__clock {
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(232, 238, 248);
}

.hud-time__controls {
    flex-direction: row;
    align-items: center;
    margin-left: 200px;
    padding-bottom: 14px;
}

.hud-speed {
    width: 42px;
    height: 30px;
    margin: 0;
    margin-right: 5px;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(126, 138, 158);
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 3px;
}

.hud-speed:hover {
    color: rgb(216, 226, 242);
    background-color: rgba(255, 255, 255, 0.07);
}

.hud-speed--pause {
    width: 32px;
}

.hud-speed--on {
    color: rgb(244, 232, 232);
    border-color: rgb(226, 78, 62);
    background-color: rgba(226, 78, 62, 0.14);
}

.hud-skip {
    height: 30px;
    margin: 0;
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(246, 234, 236);
    background-color: rgba(94, 22, 40, 0.85);
    border-width: 1px;
    border-color: rgba(226, 78, 62, 0.55);
    border-radius: 3px;
}

.hud-skip:hover {
    background-color: rgb(120, 28, 50);
    border-color: rgb(226, 78, 62);
}

/* ---- category slots ---- */

.hud__slots {
    flex-direction: row;
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-end;
    height: 100%;
    padding-bottom: 6px;
}

.hud-slot {
    width: 84px;
    height: 64px;
    margin: 0;
    margin-left: 2px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    justify-content: flex-end;
}

.hud-slot:hover {
    background-color: rgba(255, 255, 255, 0.045);
}

/* The plate a real icon drops into later. Sized now so adding art moves nothing. */

/* Thirty percent up from 26. The bar is the thing a player looks at most and the icons were
   small enough that the label was doing all the work. */
.hud-slot__icon {
    width: 34px;
    height: 34px;
    margin-bottom: 5px;
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-slot:hover > .hud-slot__icon {
    background-color: rgba(255, 255, 255, 0.20);
}

.hud-slot--on > .hud-slot__icon {
    background-color: rgba(232, 240, 255, 0.80);
}

.hud-slot__label {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(118, 130, 150);
    margin-bottom: 7px;
}

.hud-slot:hover > .hud-slot__label {
    color: rgb(206, 218, 236);
}

.hud-slot--on > .hud-slot__label {
    color: rgb(236, 243, 255);
}

/* The selected marker: a piece of the same gradient, at the point across the
   row where its own slot sits. */

.hud-slot__underline {
    width: 60%;
    height: 2px;
    opacity: 0;
}

.hud-slot--on > .hud-slot__underline {
    opacity: 1;
}

/* ---- the day line ---- */

.hud__day {
    height: 3px;
    background-color: rgba(255, 255, 255, 0.05);
}

.hud__day-fill {
    height: 3px;
    width: 0;
}

/* ---- top bar actions, now that the toolbar is gone ---- */

.topbar__action {
    height: 26px;
    margin: 0;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(190, 202, 220);
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 3px;
}

.topbar__action:hover {
    color: rgb(232, 240, 252);
    background-color: rgba(255, 255, 255, 0.10);
}

/* ---------------------------------------------------------------------------
   Category art, page banners and the diagonal screen change.
   --------------------------------------------------------------------------- */

/* Wider spacing between categories, and the icons carry real art now, so they
   are the thing you read and the label is the caption. */

.hud-slot {
    width: 92px;
    margin-left: 9px;
    margin-right: 9px;
    height: 60px;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 120ms;
}

.hud-slot__icon {
    width: 34px;
    height: 34px;
    margin-bottom: 5px;
    transition-property: opacity, scale;
    transition-duration: 120ms;
}

/* A plate is a placeholder. Once there is art, the plate would be a box behind it. */

.hud-slot__icon--art {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.62;
}

.hud-slot:hover > .hud-slot__icon--art {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.92;
    scale: 1.06 1.06;
}

.hud-slot--on > .hud-slot__icon--art {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

/* ---- the banner under a page heading ---- */

.page-banner {
    height: 84px;
    margin-top: 2px;
    margin-bottom: 10px;
    flex-shrink: 0;
    justify-content: flex-end;
    border-radius: 4px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.page-banner__edge {
    height: 2px;
    opacity: 0.75;
}

/* ---- the diagonal screen change ---- */

.content-host {
    overflow: hidden;
}

/* Where the incoming page starts. One frame later the class comes off and the
   transition below carries it home. */

.content-host--entering > .content {
    translate: 26px 18px;
    opacity: 0;
}

.content {
    transition-property: translate, opacity;
    transition-duration: 260ms;
    transition-timing-function: ease-out-cubic;
}

/* A skewed band of the accent crossing the page behind the new content. */

.page-sweep {
    position: absolute;
    left: -60%;
    top: -30%;
    width: 46%;
    height: 170%;
    opacity: 0.30;
    rotate: 14deg;
    transition-property: left, opacity;
    transition-duration: 420ms;
    transition-timing-function: ease-in-out-sine;
}

.page-sweep--gone {
    left: 130%;
    opacity: 0;
}

/* ---------------------------------------------------------------------------
   The staged creator: a rail of steps, a band of live figures under it, and one
   decision at a time below that. Nothing on it scrolls.
   --------------------------------------------------------------------------- */

.stage-rail {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 6px;
    margin-bottom: 10px;
}

.stage-pip {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin: 0;
    margin-right: 6px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    transition-property: background-color, border-color;
    transition-duration: 140ms;
}

.stage-pip:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.stage-pip--done {
    border-color: rgba(226, 78, 62, 0.45);
}

.stage-pip--on {
    background-color: rgba(226, 78, 62, 0.10);
    border-color: rgb(226, 78, 62);
}

.stage-pip__number {
    width: 20px;
    height: 20px;
    margin-right: 9px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(150, 162, 180);
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 10px;
}

.stage-pip--on .stage-pip__number {
    color: rgb(248, 238, 238);
    background-color: rgb(140, 34, 44);
}

.stage-pip__name {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(150, 162, 180);
}

.stage-pip--on .stage-pip__name {
    color: rgb(238, 244, 255);
}

/* ---- the live figures band ---- */

.effect-banner {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 12px;
    background-color: rgb(20, 24, 32);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-left-width: 2px;
    border-left-color: rgb(226, 78, 62);
    border-radius: 4px;
}

.effect-banner--blocked {
    border-left-color: rgb(214, 106, 106);
    background-color: rgb(28, 20, 22);
}

.effect-figure {
    width: 25%;
    padding-right: 14px;
}

.effect-figure__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(126, 140, 160);
}

.effect-figure__value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(228, 236, 248);
    margin-top: 1px;
    margin-bottom: 1px;
}

.effect-figure__note {
    font-size: 10px;
    color: rgb(116, 128, 148);
    white-space: normal;
}

.effect-figure__note--good {
    color: rgb(112, 200, 136);
}

.effect-figure__note--bad {
    color: rgb(222, 110, 110);
}

.effect-banner__blocked {
    width: 100%;
    margin-top: 8px;
    font-size: 12px;
    color: rgb(230, 150, 150);
    white-space: normal;
}

/* ---- the stage itself ---- */

.stage-host {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    transition-property: translate, opacity;
    transition-duration: 240ms;
    transition-timing-function: ease-out-cubic;
}

.stage-host--entering {
    translate: 22px 14px;
    opacity: 0;
}

.stage__blurb {
    font-size: 13px;
    color: rgb(150, 162, 180);
    white-space: normal;
    margin-bottom: 10px;
}

.stage-footer {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 10px;
}

/* ---- title and stage rail share one line ---- */

.stage-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.stage-header__title {
    width: 190px;
    flex-shrink: 0;
    margin-bottom: 0;
}

.stage-header > .stage-rail {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
}

.stage-header .stage-pip {
    flex-shrink: 1;
    padding-left: 10px;
    padding-right: 8px;
}

/* ---- figures carry a bar instead of a sentence ---- */

.effect-figure__track {
    height: 4px;
    margin-top: 7px;
    margin-right: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 2px;
    overflow: hidden;
}

.effect-figure__fill {
    height: 4px;
}

.effect-figure__value--up {
    color: rgb(150, 226, 176);
}

.effect-figure__value--down {
    color: rgb(232, 142, 142);
}

/* ---- taller banners ---- */

.page-banner {
    height: 126px;
}

/* ---- a creator stage with its own picture ---- */

.stage-split {
    flex-direction: row;
    flex-shrink: 0;
}

.stage-art {
    /* Was 46%. Half the window on a photograph, while the panels beside it were being cut off at
       the bottom of the screen. The laptop still reads clearly at this size. */
    width: 34%;
    flex-shrink: 0;
    margin-right: 16px;
    min-height: 300px;
    -unity-background-scale-mode: scale-to-fit;
}

.stage-split__body {
    flex-grow: 1;
    flex-shrink: 1;
}

/* ---- a decision that is designed and not yet built ---- */

.coming-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(255, 255, 255, 0.025);
    border-left-width: 2px;
    border-color: rgba(178, 158, 226, 0.55);
    border-radius: 3px;
}

.coming-row__label {
    width: 150px;
    flex-shrink: 0;
    font-size: 12px;
    color: rgb(150, 162, 180);
}

.coming-row__value {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(214, 224, 238);
}

.coming-row__tag {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(24, 20, 34);
    background-color: rgb(178, 158, 226);
    border-radius: 2px;
}

/* ---- the site screen ---- */

.site-stage {
    flex-grow: 1;
    min-height: 320px;
    align-items: center;
    justify-content: center;
    background-color: rgb(15, 19, 26);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 5px;
}

.site-stage__title {
    font-size: 17px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(120, 134, 156);
}

.site-stage__note {
    max-width: 480px;
    margin-top: 8px;
    font-size: 12px;
    color: rgb(104, 116, 136);
    white-space: normal;
    -unity-text-align: middle-center;
}

.site-strip {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 12px;
}

.site-figure {
    width: 25%;
    padding-right: 14px;
}

.site-figure__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(126, 140, 160);
}

.site-figure__value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(228, 236, 248);
}

/* ---- the run in flight, top right, always visible ---- */

.training-banner {
    position: absolute;

    /* Below the pulse banner, which now starts at 54px and is about 46px tall. */
    top: 108px;
    right: 20px;
    width: 320px;
    padding-top: 9px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(64, 16, 26, 0.94);
    border-width: 1px;
    border-color: rgb(196, 148, 46);
    border-radius: 4px;
}

.training-banner__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.training-banner__label {
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(244, 214, 150);
}

.training-banner__days {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(232, 176, 96);
}

.training-banner__track {
    height: 4px;
    margin-top: 8px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 2px;
    overflow: hidden;
}

.training-banner__fill {
    height: 4px;
    background-color: rgb(214, 162, 62);
}

/* ---- what is written on the laptop ---- */

.laptop-screen {
    position: absolute;
    left: 22%;
    right: 22%;

    /* Measured off a screenshot: at 19% the name printed in the empty space above the lid. The
       console lines below it sit 108px further down and were already landing correctly, so this
       moves the whole block down together rather than separating them. */
    top: 32%;
    align-items: center;
}

.laptop-screen__name {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(228, 238, 252);
    -unity-text-align: middle-center;
    white-space: normal;
}

.laptop-screen__rule {
    width: 58%;
    height: 2px;
    margin-top: 8px;
    margin-bottom: 10px;
    background-color: rgb(72, 208, 148);
}

.laptop-screen__status {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgb(140, 156, 178);
}

/* ---- the two closing tiles ---- */

.deploy-tiles {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.deploy-tile {
    width: 50%;
    margin: 0;
    margin-right: 10px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(20, 24, 31);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 5px;
    align-items: flex-start;
    transition-property: background-color, border-color;
    transition-duration: 140ms;
}

.deploy-tile:hover {
    border-color: rgba(226, 78, 62, 0.55);
}

.deploy-tile--on {
    background-color: rgb(31, 22, 27);
    border-color: rgb(226, 78, 62);
}

.deploy-tile__title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(232, 240, 252);
    margin-bottom: 6px;
}

.deploy-tile__body {
    font-size: 11px;
    color: rgb(140, 152, 172);
    white-space: normal;
}

.deploy-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.chip {
    margin: 0;
    margin-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(160, 172, 190);
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 3px;
}

.chip:hover {
    color: rgb(226, 236, 250);
    background-color: rgba(255, 255, 255, 0.09);
}

.chip--on {
    color: rgb(240, 232, 238);
    background-color: rgba(226, 78, 62, 0.18);
    border-color: rgb(226, 78, 62);
}

/* ---- the gauge ---- */

.load-bar {
    margin-top: 10px;
}

.load-bar__head {
    flex-direction: row;
    justify-content: space-between;
}

.load-bar__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(130, 144, 164);
}

.load-bar__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(214, 224, 238);
}

.load-bar__track {
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    overflow: hidden;
}

.load-bar__fill {
    height: 6px;
}

.load-bar__note {
    margin-top: 6px;
    font-size: 11px;
    color: rgb(126, 138, 158);
    white-space: normal;
}

.stage-slider {
    margin-top: 10px;
}

.stage-slider__head {
    flex-direction: row;
    justify-content: space-between;
}

.stage-slider__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(130, 144, 164);
}

.stage-slider__value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(220, 230, 244);
}

/* ---- the office fills the screen, the readouts are laid over it ---- */

.site-page {
    padding-top: 0;
}

.site-stage {
    flex-grow: 1;
    min-height: 420px;
    justify-content: flex-end;
    background-color: rgb(14, 17, 23);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    overflow: hidden;
    align-items: stretch;
}

.site-stage--live {
    -unity-background-scale-mode: scale-and-crop;
    align-items: stretch;
    justify-content: flex-end;
}

.site-overlay {
    padding-top: 16px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(8, 10, 14, 0.82);
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    transition-property: translate, opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out-cubic;
}

.site-overlay--entering {
    translate: 0 40px;
    opacity: 0;
}

.hud-info {
    margin-left: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.14);
    color: rgb(198, 210, 228);
}

.hud-info:hover {
    background-color: rgba(255, 255, 255, 0.11);
}

.hud-info--on {
    background-color: rgba(120, 176, 250, 0.16);
    border-color: rgb(120, 176, 250);
    color: rgb(226, 238, 255);
}

/* ---- banners, half again taller ---- */

.page-banner {
    height: 189px;
}

/* ---- the research spine ---- */

.era {
    flex-shrink: 0;
    margin-bottom: 14px;
}

.era__heading {
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(140, 154, 176);
    margin-bottom: 4px;
}

.tree-track {
    flex-direction: row;
    align-items: center;
    height: 148px;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: 6px;
}

.tree-spine {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 73px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.10);
}

.tree-node {
    width: 96px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.tree-node--above {
    padding-bottom: 54px;
}

.tree-node {
    padding-top: 54px;
}

.tree-node--above {
    padding-top: 0;
}

/* Twenty five percent up from 48. A node is the main control on this screen and it was smaller
   than the buttons on every other one. */
.tree-pip {
    width: 60px;
    height: 60px;
    margin: 0;
    padding: 0;
    background-color: rgb(18, 22, 30);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 30px;
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 140ms;
}

.tree-pip:hover {
    border-color: rgb(120, 176, 250);
    scale: 1.08 1.08;
}

.tree-pip--ready {
    border-color: rgba(226, 78, 62, 0.75);
}

.tree-pip--running {
    border-color: rgb(214, 162, 62);
    background-color: rgba(120, 84, 20, 0.35);
}

.tree-pip--done {
    border-color: rgb(112, 200, 136);
    background-color: rgba(30, 72, 46, 0.55);
}

.tree-pip--picked {
    border-color: rgb(178, 158, 226);
    background-color: rgba(70, 56, 108, 0.55);
}

.tree-pip__icon {
    width: 30px;
    height: 30px;
    opacity: 0.85;
    -unity-background-scale-mode: scale-to-fit;
}

.tree-pip__icon--none {
    width: 10px;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.35);
    border-radius: 5px;
}

.tree-node__label {
    margin-top: 6px;
    font-size: 10.5px;
    letter-spacing: 1px;
    color: rgb(126, 140, 160);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---- the card under the spine ---- */

.research-card {
    flex-shrink: 0;
    margin-top: 4px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(20, 24, 32);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-left-width: 2px;
    border-left-color: rgb(178, 158, 226);
    border-radius: 4px;
}

.research-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.research-card__title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(232, 240, 252);
}

.research-card__status {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(140, 154, 176);
}

.research-card__status--ready {
    color: rgb(232, 150, 130);
}

.research-card__status--done {
    color: rgb(112, 200, 136);
}

.research-card__body {
    margin-top: 6px;
    font-size: 12px;
    color: rgb(160, 172, 190);
    white-space: normal;
}

.research-card__unlocks {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.unlock-row {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 10px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 3px;
}

.unlock-row__tag {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    margin-right: 8px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(18, 24, 20);
    background-color: rgb(112, 200, 136);
    border-radius: 2px;
}

.unlock-row__tag--needs {
    color: rgb(28, 22, 18);
    background-color: rgb(214, 162, 62);
}

.unlock-row__name {
    font-size: 11px;
    color: rgb(214, 224, 238);
}

.research-card__costs {
    flex-direction: row;
    margin-top: 8px;
}

.cost-figure {
    width: 25%;
}

.cost-figure__label {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(126, 140, 160);
}

.cost-figure__value {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(220, 230, 244);
}

.research-card__warning {
    margin-top: 8px;
    font-size: 11px;
    color: rgb(226, 168, 110);
    white-space: normal;
}

.research-card__blocked {
    margin-top: 6px;
    font-size: 11px;
    color: rgb(226, 140, 140);
    white-space: normal;
}

/* ---------------------------------------------------------------------------
   The demographic band on the Foundation stage.

   A pie on the left, the categories on the right. Compact on purpose: this is
   evidence for the decision above it, not a screen of its own.
   --------------------------------------------------------------------------- */

.demographics {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(18, 22, 29);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 4px;
}

/* Half the gap the panels above use, because it belongs to the panel above it. */

.demographics--tight {
    margin-top: 6px;
}

.demographics__chart {
    width: 128px;
    flex-shrink: 0;
    align-items: center;
    margin-right: 12px;
}

.market-pie {
    width: 104px;
    height: 104px;
    flex-shrink: 0;
}

.demographics__headline {
    margin-top: 6px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(228, 236, 248);
}

.demographics__caption {
    font-size: 9px;
    color: rgb(122, 134, 154);
    white-space: normal;
    -unity-text-align: middle-center;
}

.demographics__table {
    flex-grow: 1;
    flex-shrink: 1;
}

.demographics__rows {
    flex-shrink: 0;
}

.demo-row {
    flex-direction: row;
    align-items: center;
    margin: 0;
    margin-bottom: 2px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(255, 255, 255, 0.02);
    border-width: 0;
    border-left-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 2px;
    transition-property: background-color, border-color;
    transition-duration: 110ms;
}

.demo-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgb(120, 176, 250);
}

.demo-row:hover > .demo-row__name {
    color: rgb(236, 244, 255);
}

.demo-row--on {
    background-color: rgba(120, 176, 250, 0.14);
    border-color: rgb(120, 176, 250);
}

.demo-row--header {
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 4px;
}

.demo-row--header:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.demo-row__head {
    font-size: 8px;
    letter-spacing: 1px;
    color: rgb(108, 120, 140);
}

.demo-row__swatch {
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 3px;
}

.demo-row__name {
    width: 40%;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(196, 208, 226);
}

.demo-row__users {
    width: 22%;
    font-size: 11px;
    color: rgb(180, 192, 210);
    -unity-text-align: middle-right;
}

.demo-row__share {
    width: 16%;
    font-size: 11px;
    color: rgb(120, 132, 152);
    -unity-text-align: middle-right;
}

.demo-row__share--held {
    color: rgb(120, 200, 250);
    -unity-font-style: bold;
}

.demo-row__leader {
    width: 22%;
    font-size: 10px;
    color: rgb(140, 152, 172);
    -unity-text-align: middle-right;
}

.demo-row__leader--you {
    color: rgb(112, 200, 136);
    -unity-font-style: bold;
}

/* The header row has no swatch, so its first cell has to start where the others do. */

.demo-row--header > .demo-row__name {
    margin-left: 13px;
}

/* ---- the two lines along the bottom of the laptop ---- */

.laptop-console {
    position: absolute;
    left: 0;
    right: 0;
    top: 108px;
    align-items: flex-start;
    padding-left: 6px;
}

.laptop-console__line {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(96, 178, 140);
}

.laptop-console__line--type {
    color: rgb(120, 150, 190);
    margin-top: 2px;
}

/* ---------------------------------------------------------------------------
   The people counter, top right. Sits above the training strip, which starts
   at 58px, so the two never argue over the corner.
   --------------------------------------------------------------------------- */

.pulse {
    position: absolute;

    /* The top bar is 46px and holds the date, SAVE and MENU. This used to sit at 12px and cover
       all three. */
    top: 54px;
    right: 20px;
    width: 268px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(10, 14, 20, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
}

/* Losing people is the one state that gets a colour of its own, and even then it is a tint rather
   than a slab. The first version was a solid burgundy block that pulled the eye away from the
   screen the player was actually working on. */

.pulse--alarm {
    border-color: rgba(168, 62, 58, 0.7);
    background-color: rgba(38, 15, 17, 0.6);
}

.pulse__block {
    align-items: flex-start;
}

.pulse__block--right {
    align-items: flex-end;
}

.pulse__users {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(232, 240, 250);
}

.pulse__mood {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(196, 208, 226);
}

.pulse__caption {
    font-size: 8px;
    letter-spacing: 1px;
    color: rgb(112, 124, 144);
}

.pulse__arrows {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.pulse__arrows--up {
    color: rgb(104, 200, 132);
}

.pulse__arrows--down {
    color: rgb(214, 96, 88);
}

.pulse__arrows--flat {
    color: rgb(104, 114, 132);
}

/* ---------------------------------------------------------------------------
   The Scale stage: the tokens-per-parameter belt, four thin bars, and notes.
   The belt itself is drawn in ScaleBelt.cs because USS has no gradients.
   --------------------------------------------------------------------------- */

.belt-block {
    flex-shrink: 0;
    margin-top: 8px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(18, 22, 29);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 4px;
}

.belt-block__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7px;
}

.belt-block__title {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(126, 138, 158);
}

.belt-block__ratio {
    flex-grow: 1;
    margin-left: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(216, 226, 240);
}

.belt-block__badge {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    color: rgb(206, 216, 232);
}

.belt-block__badge--good {
    background-color: rgba(52, 112, 82, 0.5);
    color: rgb(150, 224, 178);
}

.belt-block__badge--bad {
    background-color: rgba(120, 52, 48, 0.5);
    color: rgb(238, 158, 150);
}

.belt {
    height: 26px;
    flex-shrink: 0;
}

.belt-block__zones {
    flex-direction: row;
    margin-top: 3px;
}

.belt-zone {
    font-size: 7px;
    letter-spacing: 1px;
    color: rgb(104, 114, 132);
}

/* The captions have to sit under the zones they name, and the efficient band is
   centred, so the three widths mirror the band edges the belt draws. */

.belt-zone--left {
    width: 34%;
}

.belt-zone--mid {
    width: 32%;
    -unity-text-align: middle-center;
    color: rgb(124, 176, 146);
}

.belt-zone--right {
    width: 34%;
    -unity-text-align: middle-right;
}

/* ---- the four thin bars ---- */

.thin-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 5px;
}

.thin-bar__label {
    width: 42%;
    font-size: 10px;
    color: rgb(168, 180, 198);
}

.thin-bar__track {
    flex-grow: 1;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    overflow: hidden;
}

.thin-bar__fill {
    height: 4px;
    border-radius: 2px;
}

.thin-bar__value {
    width: 52px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(214, 224, 238);
    -unity-text-align: middle-right;
}

/* ---- memory and notes ---- */

.scale-memory {
    margin-top: 6px;
    font-size: 10px;
    color: rgb(158, 170, 190);
}

.scale-memory--over {
    color: rgb(226, 124, 116);
    -unity-font-style: bold;
}

.scale-note {
    font-size: 10px;
    color: rgb(150, 162, 182);
    white-space: normal;
    margin-bottom: 4px;
    padding-left: 8px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.14);
}

/* ---------------------------------------------------------------------------
   What the model is for. Five tiles, locked until their research lands.
   Widths leave real slack: four trait cards once measured 1352px against a
   1340px page because a styled Button inherits the theme's margin.
   --------------------------------------------------------------------------- */

.type-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.type-tile {
    width: 122px;
    margin: 0;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    align-items: flex-start;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 3px;
    transition-property: background-color, border-color;
    transition-duration: 110ms;
}

.type-tile:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgb(120, 176, 250);
}

.type-tile--on {
    background-color: rgba(120, 176, 250, 0.16);
    border-color: rgb(120, 176, 250);
}

.type-tile--locked {
    background-color: rgba(255, 255, 255, 0.015);
    border-color: rgba(255, 255, 255, 0.05);
    opacity: 0.55;
}

.type-tile--locked:hover {
    background-color: rgba(255, 255, 255, 0.015);
    border-color: rgba(255, 255, 255, 0.05);
}

.type-tile__name {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(216, 226, 240);
    white-space: normal;
}

.type-tile__note {
    margin-top: 3px;
    font-size: 8px;
    color: rgb(126, 138, 158);
    white-space: normal;
}

.type-tile__note--locked {
    color: rgb(150, 126, 108);
}

/* The DATA stage's real numbers, which the blend was already computing while
   three placeholder rows sat on top of them. */

.data-readout {
    flex-shrink: 0;
    margin-top: 8px;
}

.scale-note--bad {
    color: rgb(226, 124, 116);
    border-left-color: rgb(168, 62, 58);
}


/* ---------------------------------------------------------------------------
   Two panels sharing a row.

   The creator was one column of stacked panels, so every stage grew downward
   until the last block fell off the screen. Anything that reads as a pair goes
   side by side instead: identity next to the series line, the scaling readout
   next to its notes.
   --------------------------------------------------------------------------- */

.panel-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
}

.panel-row > .panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 8px;
}

.panel-row > .panel:last-child {
    margin-right: 0;
}

/* A stage is allowed to scroll rather than deform. This is a floor against the
   clipping, not the layout plan: if a stage needs the scroller, it is too tall. */

.stage-split__body {
    overflow: hidden;
}

/* ---------------------------------------------------------------------------
   The money in the top bar is a button, with the same arrows the people
   counter uses so the two read as one language.
   --------------------------------------------------------------------------- */

.topbar__money {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 3px;
}

.topbar__money:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.topbar__arrows {
    margin-left: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.topbar__arrows--up { color: rgb(104, 200, 132); }
.topbar__arrows--down { color: rgb(214, 96, 88); }
.topbar__arrows--flat { color: rgb(104, 114, 132); }

/* ---- the books ---- */

.finance-host {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 8, 14, 0.82);
}

.finance {
    width: 720px;
    max-height: 82%;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(12, 18, 27);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
}

.finance__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.finance__title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(196, 208, 226);
}

.finance__toggle {
    margin: 0;
    margin-left: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 9px;
    letter-spacing: 1px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 2px;
    color: rgb(168, 180, 198);
}

.finance__toggle--on {
    background-color: rgba(120, 176, 250, 0.16);
    border-color: rgb(120, 176, 250);
    color: rgb(226, 236, 250);
}

.finance__headline {
    font-size: 26px;
    -unity-font-style: bold;
}

.finance__headline--up { color: rgb(120, 214, 148); }
.finance__headline--down { color: rgb(226, 116, 108); }

.finance__caption {
    font-size: 10px;
    color: rgb(132, 144, 164);
    margin-bottom: 10px;
}

.finance-chart {
    height: 92px;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.finance__rows {
    flex-shrink: 1;
}

.finance__group {
    margin-top: 8px;
    margin-bottom: 4px;
    font-size: 8px;
    letter-spacing: 2px;
    color: rgb(112, 124, 144);
}

.finance-row {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.finance-row__name {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(186, 198, 216);
}

.finance-row__tag {
    font-size: 7px;
    letter-spacing: 1px;
    color: rgb(120, 132, 152);
    margin-right: 8px;
}

.finance-row__value {
    width: 120px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.finance-row__value--in { color: rgb(120, 214, 148); }
.finance-row__value--out { color: rgb(226, 116, 108); }

/* ---------------------------------------------------------------------------
   Height taken back from the chrome.

   The stage rail and the effect banner were spending about a hundred and sixty
   pixels before a single decision appeared, and the panels underneath were
   being cut off at the bottom of the window. Nothing here is removed, it is
   all smaller: the banner is a readout that is glanced at, not read.
   --------------------------------------------------------------------------- */

.stage-rail {
    margin-top: 2px;
    margin-bottom: 6px;
}

.stage-pip {
    padding-top: 5px;
    padding-bottom: 5px;
}

.stage-pip__number {
    width: 16px;
    height: 16px;
    margin-right: 7px;
    font-size: 9px;
}

.effect-banner {
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 8px;
}

.effect-figure__label {
    font-size: 8px;
}

.effect-figure__value {
    font-size: 20px;
}

.effect-figure__track {
    margin-top: 4px;
}

/* ---------------------------------------------------------------------------
   The demographic table: narrower first column and a scroller.

   MODEL TYPE was taking forty percent for two short words, which pushed LEADER
   off the right edge, and the list ran past the bottom of the panel with no way
   to reach the rest.
   --------------------------------------------------------------------------- */

.demo-row__name {
    width: 20%;
}

.demo-row--header > .demo-row__name {
    margin-left: 13px;
}

.demo-row__users {
    width: 24%;
}

.demo-row__share {
    width: 18%;
}

.demo-row__leader {
    width: 24%;
}

.demographics__rows {
    max-height: 118px;
    overflow: scroll;
}

/* ---------------------------------------------------------------------------
   The fleet screen. Four stacked panels ran off the bottom of the window, so
   they sit in two rows, and the daily bill is broken into the four things it
   is actually made of.
   --------------------------------------------------------------------------- */

.fleet-bill {
    flex-shrink: 0;
}

.fleet-bill__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.fleet-bill__total {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(230, 238, 250);
}

.fleet-bar {
    height: 14px;
    flex-shrink: 0;
    border-radius: 2px;
    overflow: hidden;
}

.fleet-bill__legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 7px;
}

.fleet-key {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.fleet-key__swatch {
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 2px;
}

.fleet-key__label {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(168, 180, 198);
}

.fleet-bill__power {
    margin-top: 8px;
    font-size: 10px;
    color: rgb(148, 160, 180);
}

.fleet-bill__power--over {
    color: rgb(230, 140, 96);
    -unity-font-style: bold;
}

/* Standing in the top bar, beside the money. Quiet by default: these are numbers
   a player glances at, and only the direction needs to catch the eye. */

.topbar__standing {
    margin-left: 14px;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(150, 162, 182);
}

.topbar__standing--fans {
    color: rgb(132, 146, 168);
}

.topbar__standing--up {
    color: rgb(120, 200, 148);
}

.topbar__standing--down {
    color: rgb(214, 116, 108);
}

/* The way out of the dead end on REVIEW. Deliberately not the primary colour:
   it is a suggestion with a daily bill attached, not the action the stage is for. */

.button--unblock {
    background-color: rgba(92, 132, 196, 0.22);
    border-width: 1px;
    border-color: rgb(92, 132, 196);
    color: rgb(212, 228, 250);
    font-size: 10px;
    letter-spacing: 1px;
}

.button--unblock:hover {
    background-color: rgba(92, 132, 196, 0.34);
}

/* ---------------------------------------------------------------------------
   The product banner, top right. Built to the author's mock: a maroon header
   with the model name and a link to its management page, two meters, the
   subscriber count over a small daily chart, and the month's money along the
   bottom.

   Sits below the top bar at 54px like the counter it replaces.
   --------------------------------------------------------------------------- */

/* The corner is a stack: one banner per product on sale. The stack owns the position, so the
   banners sit in normal flow inside it and a second one lands under the first rather than on top. */
.mb-stack {
    position: absolute;
    top: 54px;
    right: 20px;
    width: 316px;
    align-items: stretch;
}

.mb {
    width: 100%;
    flex-shrink: 0;
    margin-bottom: 8px;
    background-color: rgb(250, 250, 250);
    border-width: 2px;
    border-color: rgb(24, 26, 30);
    border-radius: 7px;
    overflow: hidden;
}

.mb__head {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 8px;
    background-color: rgb(114, 12, 46);
}

.mb__title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(252, 252, 252);
}

.mb__divider {
    margin-left: 8px;
    margin-right: 8px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
}

.mb__manage {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(252, 214, 58);
}

.mb__manage:hover {
    color: rgb(255, 244, 190);
}

.mb__body {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 9px;
    padding-right: 9px;
}

.mb__meters {
    flex-direction: row;
    margin-bottom: 7px;
}

.mb-meter {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.mb-meter__label {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(28, 30, 36);
    margin-right: 5px;
}

.mb-meter__track {
    flex-grow: 1;
    height: 13px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(28, 30, 36);
}

.mb-meter__fill {
    height: 11px;
}

.mb-meter__fill--good { background-color: rgb(52, 176, 82); }
.mb-meter__fill--warm { background-color: rgb(246, 146, 30); }
.mb-meter__fill--bad { background-color: rgb(206, 48, 44); }

.mb-meter__word {
    margin-left: 5px;
    font-size: 7px;
    letter-spacing: 1px;
    color: rgb(96, 100, 110);
}

.mb__subs {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(114, 12, 46);
    margin-bottom: 3px;
}

.mb-chart {
    height: 54px;
    flex-shrink: 0;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(28, 30, 36);
}

.mb__footer {
    flex-direction: row;
    margin-top: 6px;
}

.mb-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.mb-cell__label {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(28, 30, 36);
    margin-right: 5px;
}

.mb-cell__value {
    flex-grow: 1;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(232, 232, 232);
    color: rgb(28, 30, 36);
}

.mb-cell__value--good {
    background-color: rgb(154, 214, 62);
    color: rgb(18, 46, 14);
}

.mb-cell__value--bad {
    background-color: rgb(206, 48, 44);
    color: rgb(255, 236, 234);
}

/* ---- the same strip while a run is in flight ---- */

.mb__training {
    height: 62px;
    justify-content: center;
    padding-left: 12px;
    background-color: rgb(28, 30, 36);
}

.mb__training-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(114, 12, 46);
}

.mb__training-caption {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(252, 252, 252);
}

.mb__training-days {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(214, 200, 206);
}

/* The header doubles as the fold control, and the chart is clipped so a losing
   month cannot draw over the money underneath it. */

.mb__fold {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.mb__fold:hover > .mb__title {
    color: rgb(252, 214, 58);
}

.mb__chevron {
    margin-left: 7px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.55);
}

.mb-chart {
    overflow: hidden;
}

/* The training strip, closer to the style the author liked: a thin warm rule,
   the fill behind the words, and the day count where the eye already is. */

.mb__training {
    height: 58px;
    justify-content: center;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(22, 12, 18);
    border-top-width: 1px;
    border-top-color: rgb(252, 214, 58);
}

.mb__training-fill {
    background-color: rgb(126, 16, 52);
}

.mb__training-caption {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(252, 214, 58);
}

.mb__training-days {
    margin-top: 3px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(226, 208, 214);
}

/* ---------------------------------------------------------------------------
   The hosting switch across the top of FLEET, built to the author's sketch:
   two slanted halves with a picture at each end. Owning is shut rather than
   hidden, because it is a goal and not a secret.
   --------------------------------------------------------------------------- */

.hswitch {
    flex-direction: row;
    align-items: stretch;
    height: 74px;
    flex-shrink: 0;
    margin-bottom: 12px;
    background-color: rgb(16, 20, 27);
    border-width: 2px;
    border-color: rgb(232, 226, 214);
    border-radius: 4px;
    overflow: hidden;
}

.hswitch__art {
    width: 128px;
    flex-shrink: 0;
    background-color: rgb(28, 34, 44);
    -unity-background-scale-mode: scale-and-crop;
}

.hswitch__half {
    flex-grow: 1;
    margin: 0;
    border-width: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgb(232, 226, 214);
    border-radius: 0;
    background-color: rgb(244, 240, 232);
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(20, 22, 28);
    white-space: normal;
}

.hswitch__half--on {
    background-color: rgb(252, 250, 246);
    color: rgb(114, 12, 46);
}

.hswitch__half--on:hover {
    background-color: rgb(255, 255, 255);
}

.hswitch__half--locked {
    background-color: rgb(120, 122, 126);
    color: rgb(74, 76, 82);
}

/* ---- the service readout ---- */

.service__row {
    flex-direction: row;
    align-items: center;
}

.service__dial {
    width: 128px;
    flex-shrink: 0;
    align-items: center;
}

.gauge {
    width: 116px;
    height: 66px;
    flex-shrink: 0;
}

.service__percent {
    margin-top: -22px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(58, 62, 70);
}

.service__caption {
    margin-top: 4px;
    font-size: 9px;
    color: rgb(140, 148, 164);
}

.gauge-scale {
    width: 92px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    height: 62px;
    margin-left: 10px;
    margin-right: 14px;
}

.gauge-scale__words {
    flex-grow: 1;
    justify-content: space-between;
}

.gauge-scale__word {
    font-size: 10px;
    color: rgb(150, 156, 170);
}

.gauge-scale__word--critical { color: rgb(196, 62, 44); }
.gauge-scale__word--unstable { color: rgb(176, 152, 30); }
.gauge-scale__word--stable { color: rgb(58, 158, 60); }

.gauge-scale__word--on {
    -unity-font-style: bold;
}

.gauge-scale__bar {
    width: 7px;
    margin-left: 6px;
    background-color: rgb(58, 158, 60);
    border-top-width: 20px;
    border-top-color: rgb(196, 62, 44);
    border-bottom-width: 0;
}

.gauge-scale__arrow {
    position: absolute;
    right: -12px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(28, 30, 36);
}

.service__words {
    flex-grow: 1;
    flex-shrink: 1;
}

.service__response {
    font-size: 12px;
    -unity-font-style: bold;
}

.service__headline {
    margin-top: 3px;
    font-size: 10px;
    color: rgb(168, 178, 196);
    white-space: normal;
}

.service__effect {
    margin-top: 4px;
    font-size: 10px;
    color: rgb(132, 144, 164);
    white-space: normal;
}

.service__effect--bad {
    color: rgb(226, 130, 110);
}

/* ---- the three reserved blocks ---- */

.pack-row {
    flex-direction: row;
    flex-shrink: 0;
}

.pack {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 3px;
}

.pack:last-child { margin-right: 0; }

.pack--on {
    background-color: rgba(120, 176, 250, 0.12);
    border-color: rgb(120, 176, 250);
}

.pack__name {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(222, 232, 246);
}

.pack__size {
    margin-top: 2px;
    font-size: 9px;
    color: rgb(150, 200, 250);
}

.pack__pitch {
    margin-top: 5px;
    font-size: 9px;
    color: rgb(146, 156, 174);
    white-space: normal;
}

.pack__price {
    margin-top: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(198, 208, 224);
}

.pack__controls {
    flex-direction: row;
    align-items: center;
    margin-top: 7px;
}

.pack__step {
    width: 26px;
    margin: 0;
    margin-right: 6px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 2px;
    color: rgb(226, 234, 248);
}

.pack__count {
    width: 44px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(226, 234, 248);
}

.pack__total {
    margin-top: 5px;
    font-size: 9px;
    color: rgb(120, 200, 250);
}

/* ---------------------------------------------------------------------------
   SERVICE in one line: the load dial, the words, the right-now card and the two
   charts. Built to the author's reference, which is a light card on a dark page.
   --------------------------------------------------------------------------- */

/* The banner image gave back half its height; it was a mood shot taking the
   space the readouts needed. */

.page-art {
    height: 88px;
}

.service__row {
    align-items: stretch;
}

/* The dial grew by about a third. It is the headline reading on this screen. */

.service__dial {
    width: 168px;
}

.gauge {
    width: 152px;
    height: 86px;
}

.service__percent {
    margin-top: -28px;
    font-size: 22px;
}

.gauge-scale {
    height: 80px;
}

.service__words {
    width: 220px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    margin-right: 12px;
}

/* ---- the right-now card ---- */

.rnow {
    flex-direction: row;
    width: 300px;
    flex-shrink: 0;
    margin-right: 12px;
    padding: 10px;
    background-color: rgb(250, 250, 250);
    border-radius: 4px;
}

.rnow__left {
    width: 108px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: rgb(228, 228, 230);
}

.rnow__caption {
    font-size: 12px;
    color: rgb(158, 160, 166);
}

.rnow__big {
    font-size: 26px;
    color: rgb(88, 92, 100);
}

.rnow__under {
    font-size: 9px;
    color: rgb(158, 160, 166);
}

.rnow__right {
    flex-grow: 1;
    padding-left: 10px;
}

.rnow__heading {
    font-size: 12px;
    color: rgb(120, 124, 132);
    white-space: normal;
}

.rnow__income {
    margin-top: 2px;
    margin-bottom: 5px;
    font-size: 19px;
    color: rgb(58, 62, 70);
}

.rnow-stat {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 1px;
}

.rnow-stat__name {
    font-size: 9px;
    color: rgb(150, 154, 162);
}

.rnow-stat__value {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(74, 78, 86);
}

/* ---- the two charts ---- */

.charts {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    padding: 8px;
    background-color: rgb(250, 250, 250);
    border-radius: 4px;
}

.chart-block {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
}

.chart-block:last-child { margin-right: 0; }

.chart-block__title {
    font-size: 11px;
    color: rgb(120, 124, 132);
    -unity-text-align: middle-center;
}

.lchart {
    flex-grow: 1;
    min-height: 74px;
}

.chart-block__foot {
    font-size: 8px;
    color: rgb(160, 164, 172);
    -unity-text-align: middle-center;
}

/* Research points in the top bar, beside the money. The other currency. */

.topbar__points {
    flex-direction: row;
    align-items: center;
    margin: 0;
    margin-left: 14px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 5px;
    padding-right: 7px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 3px;
}

.topbar__points:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.topbar__points-icon {
    width: 17px;
    height: 17px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.topbar__points-value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(126, 196, 250);
}

/* Research funding at the top of the tree, and the card that opens on a node. */

.rfund__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.rfund__banked {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(126, 196, 250);
}

.rfund__modes {
    flex-direction: row;
    margin-bottom: 8px;
}

.rcard {
    position: absolute;
    width: 320px;
    padding: 12px;
    background-color: rgb(16, 21, 30);
    border-width: 1px;
    border-color: rgb(120, 176, 250);
    border-radius: 5px;
}

.rcard__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.rcard__icon {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.rcard__titles {
    flex-grow: 1;
}

.rcard__title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(228, 238, 252);
    white-space: normal;
}

.rcard__badge {
    margin-top: 3px;
    font-size: 8px;
    letter-spacing: 1px;
    color: rgb(140, 152, 172);
}

.rcard__badge--ready { color: rgb(126, 210, 150); }
.rcard__badge--done { color: rgb(126, 196, 250); }

.rcard__body {
    font-size: 10px;
    color: rgb(170, 182, 200);
    white-space: normal;
}

.rcard__cost {
    margin-top: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(210, 222, 240);
}

.rcard__blocked {
    margin-top: 5px;
    font-size: 10px;
    color: rgb(226, 150, 110);
    white-space: normal;
}

.rcard__buttons {
    flex-direction: row;
    margin-top: 10px;
}

/* ---------------------------------------------------------------------------
   Sliders.

   There are nine of them and none had a style, so every one was the runtime
   theme's default: a hairline track, a grey lozenge, and full window width
   because nothing constrained it. A control that runs from one edge of the
   screen to the other is also harder to use, not easier: the hand travels a
   thousand pixels to move a number by one percent.
   --------------------------------------------------------------------------- */

.unity-base-slider {
    max-width: 560px;
    min-height: 22px;
}

.unity-base-slider__drag-container {
    min-height: 22px;
}

.unity-base-slider__tracker {
    height: 6px;
    margin-top: -3px;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 3px;
}

.unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    margin-top: -8px;
    background-color: rgb(226, 234, 248);
    border-width: 2px;
    border-color: rgb(92, 132, 196);
    border-radius: 8px;
}

.unity-base-slider:hover > .unity-base-slider__drag-container > .unity-base-slider__dragger {
    background-color: rgb(255, 255, 255);
    border-color: rgb(140, 190, 255);
    scale: 1.12 1.12;
}

.unity-base-slider:focus > .unity-base-slider__drag-container > .unity-base-slider__dragger {
    border-color: rgb(160, 205, 255);
}

/* The two creator sliders are the exception: they are the decision on that page
   and they earn the extra width. */

.creator-column .unity-base-slider {
    max-width: 100%;
}

/* ---------------------------------------------------------------------------
   Research nodes, made big enough to read.

   Forty eight pixels with a twenty six pixel glyph inside a circle is a dot
   with a smudge in it. The art is the fastest way to recognise a branch and it
   was being thrown away at that size.
   --------------------------------------------------------------------------- */

.tree-pip {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border-width: 3px;
}

.tree-pip__icon {
    width: 46px;
    height: 46px;
}

.tree-pip:hover {
    scale: 1.10 1.10;
}

/* Research bubbles rising off the desk. Presentation only: they appear when the
   simulation says points are being earned and never otherwise. */

.bubbles {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.bubble {
    position: absolute;
    background-color: rgba(122, 196, 252, 0.85);
    border-width: 1px;
    border-color: rgba(198, 230, 255, 0.9);
    border-radius: 12px;
    opacity: 1;

    /* Slow and eased, so it reads as something drifting up rather than a sprite
       being teleported. The duration matches FlightMilliseconds in the C#. */
    transition-property: bottom, left, opacity, scale;
    transition-duration: 1400ms, 1400ms, 1400ms, 1400ms;
    transition-timing-function: ease-out, ease-in-out, ease-in, ease-out;
}

.bubble--away {
    scale: 0.55 0.55;
}

/* ---------------------------------------------------------------------------
   Marketing channels as tall tiles: a darkened photograph, a name across the
   bottom. The picture is the decision aid, the numbers are in the tooltip for
   whoever wants them.
   --------------------------------------------------------------------------- */

.chan-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.chan {
    width: 152px;
    height: 208px;
    margin: 0;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 0;
    overflow: hidden;
    justify-content: flex-end;
    background-color: rgb(14, 18, 26);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    transition-property: border-color, scale;
    transition-duration: 120ms;
}

.chan:hover {
    border-color: rgb(150, 190, 250);
    scale: 1.03 1.03;
}

.chan--on {
    border-color: rgb(252, 214, 58);
}

.chan__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* Until the photographs arrive the plate is a flat panel rather than a hole. */

.chan__art--missing {
    background-color: rgb(26, 32, 44);
}

/* The scrim is what lets a realistic photograph sit inside a dark interface
   instead of shouting over it. Same rule as every other piece of card art. */

.chan__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 11, 17, 0.58);
}

.chan__name {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(246, 248, 252);
    padding-left: 11px;
    padding-right: 11px;
}

.chan__price {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(176, 190, 212);
    padding-left: 11px;
    padding-bottom: 11px;
}

.run-row {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.run-row__what {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(206, 216, 232);
}

.run-row__left {
    width: 110px;
    font-size: 10px;
    color: rgb(146, 158, 178);
}

.run-row__cost {
    width: 96px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(226, 150, 130);
    -unity-text-align: middle-right;
    margin-right: 10px;
}

/* ---- the official page and the desk behind it ----

   Two views of one product, so they share a chrome and differ only in what they put in it. The
   page is warm and spaced out because it is meant to read as something a stranger landed on; the
   desk is dense because it is meant to be scanned by somebody who already knows what they are
   looking for. */

.mg-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mg-tab {
    margin: 0;
    margin-right: 4px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 11px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: rgb(150, 162, 182);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.mg-tab:hover {
    color: rgb(226, 236, 250);
}

.mg-tab--on {
    color: rgb(244, 226, 222);
    border-bottom-color: rgb(226, 78, 62);
    background-color: rgba(226, 78, 62, 0.10);
}

.mg-empty {
    align-items: flex-start;
}

/* ---- the hero ---- */

.mg-hero {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 22px;
    margin-bottom: 14px;
    border-radius: var(--card-radius);
    background-color: rgba(78, 20, 34, 0.55);
    border-left-width: 3px;
    border-left-color: rgb(226, 78, 62);
}

.mg-hero__left {
    flex-grow: 1;
    flex-shrink: 1;
    padding-right: 20px;
}

.mg-hero__name {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(248, 240, 240);
    margin-bottom: 6px;
    white-space: normal;
}

.mg-hero__line {
    font-size: 11px;
    color: rgb(206, 178, 180);
    margin-bottom: 3px;
    white-space: normal;
}

.mg-hero__right {
    flex-shrink: 0;
    align-items: flex-end;
}

.mg-hero__score {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(248, 240, 240);
    margin-top: 4px;
}

.mg-hero__who {
    font-size: 10px;
    letter-spacing: 0.6px;
    color: rgb(206, 178, 180);
}

.mg-rate {
    flex-direction: row;
    align-items: center;
}

.mg-pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-left: 4px;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
}

.mg-pip--on {
    background-color: rgb(230, 176, 74);
    border-color: rgb(240, 198, 116);
}

/* ---- the status line ---- */

.mg-status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 12px;
    padding-left: 16px;
    margin-bottom: 16px;
    border-radius: var(--card-radius);
    background-color: rgba(6, 30, 62, 0.45);
}

.mg-status__dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    margin-right: 10px;
}

.mg-status__text {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-right: 14px;
}

.mg-status__detail {
    flex-grow: 1;
    font-size: 10px;
    color: rgb(150, 162, 182);
}

/* ---- the plans ---- */

.mg-plans {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.mg-plan {
    width: 230px;
    flex-shrink: 0;
    margin-right: 14px;
    padding: 16px;
    border-radius: var(--card-radius);
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.mg-plan--on {
    background-color: rgba(226, 78, 62, 0.08);
    border-color: rgba(226, 78, 62, 0.55);
}

.mg-plan__name {
    font-size: 10px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    color: rgb(160, 172, 190);
    margin-bottom: 8px;
}

.mg-plan__price {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(232, 240, 252);
}

.mg-plan__per {
    font-size: 10px;
    color: rgb(150, 162, 182);
    margin-bottom: 10px;
}

.mg-plan__line {
    font-size: 11px;
    color: rgb(196, 208, 226);
    margin-bottom: 4px;
    white-space: normal;
}

.mg-plan__tag {
    margin-top: 10px;
    font-size: 9px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: rgb(240, 190, 182);
}

/* ---- what people say ---- */

.mg-review {
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.mg-review__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.mg-review__who {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(160, 172, 190);
}

.mg-review__text {
    font-size: 12px;
    color: rgb(214, 224, 238);
    white-space: normal;
}

/* ---- the desk ---- */

.mg-kpis {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.mg-kpi {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
    padding: 16px;
    border-radius: var(--card-radius);
    background-color: rgba(6, 30, 62, 0.45);
    border-top-width: 2px;
    border-top-color: rgba(226, 78, 62, 0.45);
}

.mg-kpi__label {
    font-size: 9px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: rgb(150, 162, 182);
    margin-bottom: 8px;
    white-space: normal;
}

.mg-kpi__value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(232, 240, 252);
}

.mg-kpi__foot {
    font-size: 10px;
    color: rgb(150, 162, 182);
    margin-top: 3px;
    white-space: normal;
}

/* ---- the audience table ---- */

.mg-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.mg-row--head {
    border-bottom-color: rgba(255, 255, 255, 0.14);
    padding-bottom: 5px;
}

.mg-cell {
    font-size: 11px;
    color: rgb(214, 224, 238);
}

.mg-row--head .mg-cell {
    font-size: 9px;
    letter-spacing: 1.1px;
    -unity-font-style: bold;
    color: rgb(150, 162, 182);
}

.mg-cell--wide {
    width: 34%;
}

.mg-cell--num {
    width: 20%;
    -unity-text-align: middle-right;
}

.mg-cell--share {
    width: 20%;
    padding-left: 14px;
}

.mg-cell--lead {
    width: 26%;
    -unity-text-align: middle-right;
    color: rgb(160, 172, 190);
}

.mg-cell--mine {
    color: rgb(240, 190, 182);
    -unity-font-style: bold;
}

.mg-share__value {
    font-size: 11px;
    color: rgb(214, 224, 238);
    -unity-text-align: middle-right;
    margin-bottom: 3px;
}

.mg-share__track {
    height: 3px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    overflow: hidden;
}

.mg-share__fill {
    height: 3px;
    border-radius: 2px;
    background-color: rgb(92, 158, 224);
}


/* ---- the wire: corner banner and the news screen ----

   Laid out as a publication, not as a log. One lead story set large with a kicker over it and the
   rest small underneath, hairlines instead of boxes, a coloured rule over every section title. That
   hierarchy is the whole design: four stories at equal weight is a list the eye has to read all of,
   one large and three small is a page that tells the eye where to go. */

/* ---- corner banner, top left, opposite the model banner ---- */

/* Seventy percent transparent at rest. It sits over the office and is meant to be glanceable
   rather than read, so it comes up to full strength only on hover or when something lands. */
.nb {
    position: absolute;
    top: 54px;
    left: 20px;
    width: 300px;
    opacity: 0.3;
    background-color: rgba(10, 12, 18, 0.93);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    overflow: hidden;
    transition-property: opacity, border-color;
    transition-duration: 220ms;
}

.nb:hover {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.28);
}

/* Two seconds after a story lands, then back down. A banner that stays bright until it is clicked
   is a banner that is bright permanently by the second year. */
.nb--new {
    opacity: 1;
    border-color: rgb(226, 78, 62);
}

.nb__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgb(226, 78, 62);
}

.nb__masthead {
    font-size: 11px;
    letter-spacing: 2.4px;
    -unity-font-style: bold;
    color: rgb(252, 244, 242);
}

.nb__badge {
    min-width: 18px;
    height: 18px;
    padding-left: 5px;
    padding-right: 5px;
    border-radius: 9px;
    background-color: rgb(252, 244, 242);
    color: rgb(184, 46, 34);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nb__body {
    flex-direction: row;
    padding: 11px;
}

.nb__rule {
    width: 3px;
    border-radius: 2px;
    margin-right: 10px;
    background-color: rgb(120, 132, 152);
}

.nb__rule--loud {
    background-color: rgb(230, 176, 74);
}

.nb__rule--scandal {
    background-color: rgb(214, 66, 58);
}

.nb__rule--premiere {
    background-color: rgb(64, 176, 128);
}

.nb__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.nb__kicker {
    font-size: 8px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(226, 120, 104);
    margin-bottom: 3px;
}

.nb__headline {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
    white-space: normal;
}

.nb__dateline {
    font-size: 9px;
    color: rgb(128, 140, 158);
    margin-top: 4px;
}

.nb__open {
    margin: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 10px;
    letter-spacing: 1.8px;
    -unity-font-style: bold;
    color: rgb(226, 236, 250);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
    border-radius: 0;
}

.nb__open:hover {
    background-color: rgba(226, 78, 62, 0.30);
    color: rgb(255, 250, 248);
}

/* ---- the screen ---- */

/* The page itself needs to fill its host, or the three columns have no height to divide. */
.news {
    flex-grow: 1;
}

.news__masthead {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    flex-shrink: 0;
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(226, 78, 62);
}

.news__title {
    font-size: 34px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
}

.news__strap {
    font-size: 11px;
    color: rgb(140, 152, 172);
    margin-top: 2px;
    white-space: normal;
}

.news__mastright {
    align-items: flex-end;
    flex-shrink: 0;
    padding-left: 20px;
}

.news__date {
    font-size: 11px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(214, 224, 238);
}

.news__spend {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 3px;
}

.news__columns {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.news-col {
    flex-shrink: 0;
    padding-right: 20px;
}

.news-col--wire {
    width: 25%;
}

.news-col--middle {
    width: 41%;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    padding-left: 20px;
}

.news-col--desks {
    width: 34%;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    padding-left: 20px;
    padding-right: 0;
}

.news-scroll {
    flex-grow: 1;
    max-height: 560px;
}

/* Section headings: a coloured rule, then the word. */

.sec {
    flex-shrink: 0;
    margin-bottom: 10px;
}

.sec__rule {
    height: 2px;
    margin-bottom: 6px;
    background-color: rgb(120, 132, 152);
}

.sec__title {
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(226, 236, 250);
}

.rule--wire {
    background-color: rgb(120, 132, 152);
}

.rule--scandal {
    background-color: rgb(214, 66, 58);
}

.rule--premiere {
    background-color: rgb(64, 176, 128);
}

.rule--gold {
    background-color: rgb(230, 176, 74);
}

.rule--blue {
    background-color: rgb(92, 158, 224);
}

.rule--violet {
    background-color: rgb(148, 122, 220);
}

/* The wire rows. */

.wire-row {
    flex-direction: row;
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.wire-row__rule {
    width: 2px;
    margin-right: 9px;
    border-radius: 1px;
}

.wire-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.wire-row__headline {
    font-size: 11px;
    color: rgb(210, 220, 236);
    white-space: normal;
}

.wire-row__headline--mine {
    color: rgb(244, 206, 198);
    -unity-font-style: bold;
}

.wire-row__meta {
    font-size: 9px;
    color: rgb(118, 130, 150);
    margin-top: 2px;
}

/* The middle sections. */

.news-section {
    flex-shrink: 0;
    margin-bottom: 22px;
}

.lead {
    flex-shrink: 0;
    padding-bottom: 12px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.lead__kicker {
    font-size: 8px;
    letter-spacing: 1.8px;
    -unity-font-style: bold;
    color: rgb(140, 152, 172);
    margin-bottom: 4px;
}

.lead__kicker--mine {
    color: rgb(226, 120, 104);
}

.lead__headline {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
    white-space: normal;
}

.lead__body {
    font-size: 11px;
    color: rgb(168, 180, 198);
    margin-top: 6px;
    white-space: normal;
}

.lead__date {
    font-size: 9px;
    color: rgb(118, 130, 150);
    margin-top: 7px;
}

.small {
    flex-shrink: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.small__headline {
    font-size: 12px;
    color: rgb(214, 224, 238);
    white-space: normal;
}

.small__headline--mine {
    color: rgb(244, 206, 198);
    -unity-font-style: bold;
}

.small__meta {
    font-size: 9px;
    color: rgb(118, 130, 150);
    margin-top: 2px;
}

/* The paid desks. */

.desk {
    flex-shrink: 0;
    padding: 14px;
    margin-bottom: 14px;
    border-radius: var(--card-radius);
    background-color: rgba(6, 30, 62, 0.45);
    border-left-width: 3px;
    border-left-color: rgb(120, 132, 152);
}

.desk--gold {
    border-left-color: rgb(230, 176, 74);
}

.desk--blue {
    border-left-color: rgb(92, 158, 224);
}

.desk--violet {
    border-left-color: rgb(148, 122, 220);
}

.desk--shut {
    background-color: rgba(6, 18, 34, 0.55);
}

.desk__head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 8px;
}

.desk__title {
    font-size: 13px;
    letter-spacing: 2.2px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

.desk__outlet {
    font-size: 9px;
    letter-spacing: 0.8px;
    color: rgb(140, 152, 172);
}

.desk__pitch {
    font-size: 11px;
    color: rgb(160, 172, 190);
    white-space: normal;
    margin-bottom: 10px;
}

.desk__locked {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(226, 150, 130);
    white-space: normal;
    margin-bottom: 10px;
}

.desk__second {
    font-size: 10px;
    color: rgb(140, 152, 172);
    white-space: normal;
    margin-top: 8px;
}

.desk__join {
    margin: 0;
    margin-top: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    width: 100%;
    font-size: 10px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: rgb(240, 232, 238);
    background-color: rgba(226, 78, 62, 0.24);
    border-width: 1px;
    border-color: rgba(226, 78, 62, 0.65);
    border-radius: 3px;
}

.desk__join:hover {
    background-color: rgba(226, 78, 62, 0.42);
}

.desk__join--held {
    color: rgb(150, 162, 182);
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
}

.news-empty {
    font-size: 11px;
    color: rgb(128, 140, 158);
    white-space: normal;
    padding-top: 6px;
    padding-bottom: 10px;
}


/* ---- managing one model: shutdown, upgrade, who is on it ----

   Built to the same shape as the hosting switch, because it answers the same kind of question: two
   heavy actions side by side with the state of the thing between them, rather than a menu. Red left,
   amber middle, the live figure right. SHUTDOWN is absent rather than disabled on a withdrawn model,
   and a spacer keeps the middle button in the same column so a list does not shuffle sideways. */

.mcb {
    flex-direction: row;
    align-items: stretch;
    height: 52px;
    flex-shrink: 0;
    margin-top: 10px;
    background-color: rgb(16, 20, 27);
    border-width: 2px;
    border-color: rgb(232, 226, 214);
    border-radius: 4px;
    overflow: hidden;
}

.mcb--armed {
    border-color: rgb(226, 78, 62);
}

.mcb__stop {
    width: 34%;
    margin: 0;
    border-width: 0;
    border-right-width: 2px;
    border-right-color: rgb(232, 226, 214);
    border-radius: 0;
    font-size: 13px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(252, 240, 238);
    background-color: rgb(158, 38, 32);
}

.mcb__stop:hover {
    background-color: rgb(196, 48, 40);
}

.mcb__stop--armed {
    background-color: rgb(226, 78, 62);
    color: rgb(255, 252, 250);
    font-size: 12px;
}

.mcb__gone {
    width: 34%;
    -unity-text-align: middle-center;
    font-size: 10px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(110, 120, 138);
    background-color: rgba(255, 255, 255, 0.03);
    border-right-width: 2px;
    border-right-color: rgba(232, 226, 214, 0.35);
}

.mcb__upgrade {
    width: 33%;
    margin: 0;
    border-width: 0;
    border-right-width: 2px;
    border-right-color: rgb(232, 226, 214);
    border-radius: 0;
    font-size: 13px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(46, 34, 8);
    background-color: rgb(224, 176, 62);
}

.mcb__upgrade:hover {
    background-color: rgb(242, 196, 84);
}

.mcb__upgrade:disabled {
    color: rgb(120, 112, 96);
    background-color: rgb(86, 76, 52);
}

.mcb__active {
    flex-grow: 1;
    justify-content: center;
    padding-left: 14px;
    background-color: rgb(244, 240, 232);
}

.mcb__caption {
    font-size: 9px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(122, 116, 104);
}

.mcb__figure {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(28, 26, 24);
}

.mcb-problem {
    flex-shrink: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(232, 150, 130);
    white-space: normal;
    padding: 10px;
    margin-bottom: 12px;
    border-radius: var(--card-radius);
    background-color: rgba(158, 38, 32, 0.22);
}

/* ---- the archive ---- */

.archive-scroll {
    flex-grow: 1;
}

.arch {
    flex-shrink: 0;
    padding: 16px;
    margin-bottom: 12px;
    border-radius: var(--card-radius);
    background-color: rgba(6, 30, 62, 0.40);
    border-left-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.10);
}

.arch--live {
    border-left-color: rgb(64, 176, 128);
    background-color: rgba(6, 40, 62, 0.52);
}

.arch--gone {
    border-left-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(6, 18, 34, 0.40);
}

.arch__head {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.arch__name {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: rgb(238, 242, 250);
    white-space: normal;
}

.arch__line {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 3px;
    white-space: normal;
}

.arch__state {
    flex-shrink: 0;
    margin-left: 12px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 3px;
    font-size: 8px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}

.arch__state--live {
    color: rgb(214, 250, 230);
    background-color: rgba(64, 176, 128, 0.30);
}

.arch__state--shadow {
    color: rgb(240, 220, 180);
    background-color: rgba(224, 176, 62, 0.22);
}

.arch__state--gone {
    color: rgb(150, 162, 182);
    background-color: rgba(255, 255, 255, 0.05);
}

.arch__figures {
    flex-direction: row;
    margin-top: 12px;
}

.arch-figure {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 12px;
}

.arch-figure__label {
    font-size: 8px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    color: rgb(140, 152, 172);
}

.arch-figure__value {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(232, 240, 252);
    margin-top: 2px;
}

.arch-figure__foot {
    font-size: 9px;
    color: rgb(128, 140, 158);
    margin-top: 2px;
    white-space: normal;
}

/* A follower is the same panel at a lower density: no chart, no training strip, and two cells that
   answer for the model rather than for the company. */
.mb--compact .mb__body {
    padding-top: 8px;
    padding-bottom: 8px;
}

.mb--compact .mb__manage {
    display: none;
}

.mb--compact .mb__divider {
    display: none;
}


/* ---- the inbox ----

   A list on the left, the letter on the right, the answer at the bottom of it. The wire reports and
   the inbox asks, so everything here is built around the one line that says what a letter wants:
   the amount, the deadline, or the salary somebody is holding out for. */

.mail {
    flex-grow: 1;
}

.mail__header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    flex-shrink: 0;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(226, 78, 62);
}

.mail__title {
    font-size: 30px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
}

.mail__strap {
    font-size: 11px;
    color: rgb(140, 152, 172);
    margin-top: 2px;
    white-space: normal;
}

.mail__strap--owing {
    color: rgb(232, 150, 130);
    -unity-font-style: bold;
}

.mail__filters {
    flex-direction: row;
    flex-shrink: 0;
    padding-left: 20px;
}

.mail__columns {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.mail-list {
    width: 34%;
    flex-shrink: 0;
    padding-right: 16px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
}

.mail-scroll {
    flex-grow: 1;
    max-height: 580px;
}

.mail-empty {
    font-size: 11px;
    color: rgb(128, 140, 158);
    white-space: normal;
    padding: 14px;
}

/* one row in the list */

.mail-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    margin: 0;
    margin-bottom: 2px;
    padding: 10px;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.mail-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.mail-row--on {
    background-color: rgba(226, 78, 62, 0.12);
    border-left-color: rgb(226, 78, 62);
}

.mail-row--closed {
    opacity: 0.55;
}

.mail-row__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-top: 5px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: rgb(120, 132, 152);
}

.mail-row__dot--money {
    background-color: rgb(230, 176, 74);
}

.mail-row__dot--people {
    background-color: rgb(92, 158, 224);
}

.mail-row__dot--late {
    background-color: rgb(214, 66, 58);
}

.mail-row__dot--done {
    background-color: rgba(255, 255, 255, 0.16);
}

.mail-row__dot--plain {
    background-color: rgb(120, 132, 152);
}

.mail-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.mail-row__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
}

.mail-row__sender {
    font-size: 11px;
    color: rgb(196, 208, 226);
    flex-shrink: 1;
}

.mail-row--unread .mail-row__sender {
    color: rgb(240, 244, 252);
    -unity-font-style: bold;
}

.mail-row__date {
    font-size: 9px;
    color: rgb(118, 130, 150);
    flex-shrink: 0;
    padding-left: 8px;
}

.mail-row__subject {
    font-size: 12px;
    color: rgb(214, 224, 238);
    margin-top: 2px;
    white-space: normal;
}

.mail-row--unread .mail-row__subject {
    -unity-font-style: bold;
    color: rgb(246, 248, 253);
}

.mail-row__wants {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 3px;
    white-space: normal;
}

.mail-row__wants--late {
    color: rgb(232, 130, 112);
    -unity-font-style: bold;
}

/* the reading pane */

.mail-read {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 22px;
}

.mail-read__subject {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(242, 246, 253);
    white-space: normal;
}

.mail-read__from {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mail-read__avatar {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    margin-right: 12px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(16, 20, 27);
    flex-shrink: 0;
}

.mail-read__sender {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(226, 236, 250);
}

.mail-read__date {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 2px;
}

.mail-read__body {
    font-size: 13px;
    color: rgb(206, 216, 232);
    white-space: normal;
}

.mail-read__problem {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(232, 150, 130);
    white-space: normal;
    margin-top: 14px;
    padding: 10px;
    border-radius: var(--card-radius);
    background-color: rgba(158, 38, 32, 0.22);
}

.mail-read__closed {
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(140, 152, 172);
    margin-top: 18px;
    padding: 10px;
    border-radius: var(--card-radius);
    background-color: rgba(255, 255, 255, 0.04);
}

/* the amount block */

.mail-amount {
    flex-shrink: 0;
    margin-top: 18px;
    padding: 14px;
    border-radius: var(--card-radius);
    background-color: rgba(6, 30, 62, 0.50);
    border-left-width: 3px;
    border-left-color: rgb(230, 176, 74);
}

.mail-amount--late {
    border-left-color: rgb(214, 66, 58);
    background-color: rgba(90, 22, 18, 0.40);
}

.mail-amount__label {
    font-size: 9px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(150, 162, 182);
}

.mail-amount__value {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(244, 248, 255);
    margin-top: 2px;
}

.mail-amount__foot {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 2px;
}

/* the answer */

.mail-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 18px;
}

.mail-action {
    margin: 0;
    margin-right: 10px;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 11px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    border-width: 1px;
    border-radius: 3px;
    color: rgb(226, 236, 250);
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
}

.mail-action:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.mail-action--pay {
    color: rgb(18, 30, 20);
    background-color: rgb(78, 176, 106);
    border-color: rgb(110, 200, 136);
}

.mail-action--pay:hover {
    background-color: rgb(98, 200, 128);
}

.mail-action--yes {
    color: rgb(18, 26, 34);
    background-color: rgb(92, 158, 224);
    border-color: rgb(126, 184, 240);
}

.mail-action--yes:hover {
    background-color: rgb(116, 180, 240);
}

.mail-action--haggle {
    color: rgb(46, 34, 8);
    background-color: rgb(224, 176, 62);
    border-color: rgb(240, 198, 108);
}

.mail-action--haggle:hover {
    background-color: rgb(240, 196, 84);
}

.mail-action--no {
    color: rgb(160, 172, 190);
}

/* the badge on the bottom bar */

.hud-slot__badge {
    position: absolute;
    top: 4px;
    right: 6px;
    min-width: 16px;
    height: 16px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 8px;
    background-color: rgb(226, 78, 62);
    color: rgb(255, 250, 248);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* open facilities on the capital screen */

.loan-open {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    flex-shrink: 0;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.loan-open__name {
    font-size: 11px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: rgb(226, 236, 250);
}

.loan-open__left {
    font-size: 11px;
    color: rgb(168, 180, 198);
}

.card__line--blocked {
    color: rgb(206, 138, 122);
}

/* The two ends of the hosting switch are where hosting_renting.png and hosting_datacenter.png go.
   Until they exist the halves are told apart by tone rather than by nothing, and the owned side is
   the duller one because it is the half that is deliberately locked. */
.hswitch__art--left {
    background-color: rgb(30, 38, 50);
    border-right-width: 2px;
    border-right-color: rgb(232, 226, 214);
}

.hswitch__art--right {
    background-color: rgb(22, 26, 33);
    border-left-width: 2px;
    border-left-color: rgb(232, 226, 214);
}


/* ---- rival marks, and the board they sit on ----

   Nine rows of text read as a list to be searched. Nine marks read as a field the eye can find
   itself in, which is the only reason the logos are worth loading at all. */

.lab-badge {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 12px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* Contain rather than crop: these are marks, and a cropped logo is a different logo. */
.lab-badge--art {
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0.04);
}

.lab-badge--mine {
    background-color: rgba(226, 78, 62, 0.22);
    border-color: rgb(226, 78, 62);
}

.lab-badge__initial {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 236, 250);
}

.rank-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.rank-row--mine {
    background-color: rgba(226, 78, 62, 0.08);
    border-left-width: 2px;
    border-left-color: rgb(226, 78, 62);
    padding-left: 8px;
}

.rank-row__place {
    width: 28px;
    flex-shrink: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(140, 152, 172);
}

.rank-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rank-row__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(232, 240, 252);
}

.rank-row__model {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 1px;
}

.rank-row__score {
    width: 62px;
    flex-shrink: 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
    -unity-text-align: middle-right;
}

.rank-row__detail {
    width: 168px;
    flex-shrink: 0;
    font-size: 10px;
    color: rgb(150, 162, 182);
    -unity-text-align: middle-right;
}


/* ---- research: the first era and the funding panel share a line ----

   Funding is a setting a player touches twice a campaign and the tree is what they came for, so the
   tree starts at the top of the screen and the setting fills the space beside the first era, whose
   track is short enough to leave it empty anyway. */

.era-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.era--beside {
    flex-grow: 1;
    flex-shrink: 1;
    padding-right: 20px;
}

.era-row .rfund-half {
    width: 34%;
    flex-shrink: 0;
}

/* ---- the card that opens under the cursor ----

   This is where a node is read and started. It was written months ago and never called from
   anywhere, so clicking a node moved a ring and told the player nothing. */

.rcard__opens {
    font-size: 9px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(140, 154, 176);
    margin-top: 12px;
    margin-bottom: 4px;
}

.rcard__unlock {
    font-size: 11px;
    color: rgb(196, 208, 226);
    white-space: normal;
    margin-bottom: 2px;
    padding-left: 8px;
}

.rcard__costs {
    flex-direction: row;
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
}

.rcard-figure {
    flex-grow: 1;
    flex-basis: 0;
}

.rcard-figure__label {
    font-size: 8px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    color: rgb(140, 154, 176);
}

.rcard-figure__value {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(238, 244, 252);
    margin-top: 1px;
}

/* Red rather than hidden. The player is allowed to look at a node they cannot afford yet and see
   exactly which of the two things they are short of. */
.rcard-figure--short .rcard-figure__value {
    color: rgb(232, 130, 112);
}

.rcard__have {
    font-size: 10px;
    color: rgb(140, 152, 172);
    margin-top: 8px;
}
